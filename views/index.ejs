<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Manager - Node Edition</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width: 600px; margin: 40px auto; padding: 20px; line-height: 1.6; }
        .task-item { display: flex; justify-content: space-between; padding: 10px; border-bottom: 1px solid #eee; align-items: center; }
        .completed { text-decoration: line-through; color: #888; }
        .btn { padding: 5px 10px; text-decoration: none; border-radius: 4px; font-size: 0.8em; }
        .btn-del { background: #ff4444; color: white; }
        .btn-toggle { background: #00C851; color: white; }
        form { margin-bottom: 20px; display: flex; gap: 10px; }
        input[type="text"] { flex-grow: 1; padding: 8px; }
        button { cursor: pointer; padding: 8px 15px; background: #33b5e5; border: none; color: white; border-radius: 4px; }
    </style>
</head>
<body>
    <h1>Task Manager</h1>

    <!-- Form for adding new tasks -->
    <form action="/tasks" method="POST">
        <input type="text" name="title" placeholder="What needs to be done?" required>
        <button type="submit">Add Task</button>
    </form>

    <!-- Task List -->
    <div class="task-list">
        <% if (tasks.length === 0) { %>
            <p>No tasks found. Add one above!</p>
        <% } %>
        
        <% tasks.forEach(task => { %>
            <div class="task-item">
                <span class="<%= task.completed ? 'completed' : '' %>">
                    <%= task.title %>
                </span>
                <div>
                    <a href="/tasks/toggle/<%= task.id %>" class="btn btn-toggle">
                        <%= task.completed ? 'Undo' : 'Done' %>
                    </a>
                    <a href="/tasks/delete/<%= task.id %>" class="btn btn-del" onclick="return confirm('Are you sure?')">
                        Delete
                    </a>
                </div>
            </div>
        <% }) %>
    </div>
</body>
</html>
