<%- include('../common/header', { title: __('owner.ownerListTitle'), activePage: 'owners' }) %>

<div class="container my-4">
    <h2 class="mb-4"><%= __('owner.ownerListTitle') %></h2>

    <% if (owners && owners.length > 0) { %>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col"><%= __('common.firstName') %></th>
                    <th scope="col"><%= __('common.lastName') %></th>
                    <th scope="col"><%= __('common.address') %></th>
                    <th scope="col"><%= __('common.city') %></th>
                    <th scope="col"><%= __('common.telephone') %></th>
                </tr>
            </thead>
            <tbody>
                <% owners.forEach(owner => { %>
                    <tr>
                        <td><a href="/owners/<%= owner.id %>"><%= owner.firstName %></a></td>
                        <td><a href="/owners/<%= owner.id %>"><%= owner.lastName %></a></td>
                        <td><%= owner.address %></td>
                        <td><%= owner.city %></td>
                        <td><%= owner.telephone %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <p><%= __('owner.notFound') %>.</p>
    <% } %>
</div>

<%- include('../common/footer') %>
