<%- /* This fragment is intended to be used with `include` and pass variables */ -%>
<div class="form-group<%= locals.errors && locals.errors[name] ? ' has-error' : '' %>">
  <label for="<%= name %>" class="col-sm-2 control-label"><%= label %></label>
  <div class="col-sm-10">
    <% if (type === 'text') { %>
      <input class="form-control" type="text" id="<%= name %>" name="<%= name %>" value="<%= value || '' %>" />
    <% } else if (type === 'date') { %>
      <input class="form-control" type="date" id="<%= name %>" name="<%= name %>" value="<%= value ? temporals.format(value, 'YYYY-MM-DD') : '' %>" />
    <% } %>
    <% if (locals.errors && locals.errors[name]) { %>
      <span class="fa fa-remove form-control-feedback" aria-hidden="true"></span>
      <span class="help-inline"><%= errors[name] %></span>
    <% } %>
  </div>
</div>
