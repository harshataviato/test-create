<!DOCTYPE html>
<html lang="<%= __locales[__locale].lang %>">
<head>
  <%- include('../fragments/head', { title: __('layoutTitle'), menu: 'owners' }) %>
</head>
<body>
  <%- include('../fragments/header', { menu: 'owners' }) %>

  <div class="container-fluid">
    <div class="container xd-container">
      <h2 class="mt-4">
        <% if (visit.isNew()) { %>
          <%- __('new') %>
        <% } %>
        Visit
      </h2>

      <h3 class="mt-4"><%= __('pet') %></h3>
      <table class="table table-striped">
        <thead>
          <tr>
            <th><%= __('name') %></th>
            <th><%= __('birthDate') %></th>
            <th><%= __('type') %></th>
            <th><%= __('owner') %></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><%= pet.name %></td>
            <td><%= moment(pet.birthDate).format('YYYY-MM-DD') %></td>
            <td><%= pet.type ? pet.type.name : '' %></td>
            <td><%= owner.firstName + ' ' + owner.lastName %></td>
          </tr>
        </tbody>
      </table>

      <form action="/owners/<%= owner.id %>/pets/<%= pet.id %>/visits/new" class="form-horizontal" method="post">
        <div class="form-group has-feedback">
          <%- include('../fragments/inputField', {
            label: __('date'),
            name: 'date',
            type: 'date',
            value: visit.date,
            errors: locals.errors,
            __: __
          }) %>
          <%- include('../fragments/inputField', {
            label: __('description'),
            name: 'description',
            type: 'text',
            value: visit.description,
            errors: locals.errors,
            __: __
          }) %>
        </div>

        <div class="form-group">
          <div class="col-sm-offset-2 col-sm-10">
            <input type="hidden" name="petId" value="<%= pet.id %>" />
            <button class="btn btn-primary mt-3" type="submit"><%= __('addVisit') %></button>
          </div>
        </div>
      </form>

      <br />
      <h3 class="mt-4"><%= __('previousVisits') %></h3>
      <table class="table table-striped">
        <thead>
          <tr>
            <th><%= __('date') %></th>
            <th><%= __('description') %></th>
          </tr>
        </thead>
        <tbody>
          <% if (pet.getVisits().length > 0) { %>
            <% pet.getVisits().forEach(prevVisit => { %>
              <% if (prevVisit.id !== visit.id) { %>
                <tr>
                  <td><%= moment(prevVisit.date).format('YYYY-MM-DD') %></td>
                  <td><%= prevVisit.description %></td>
                </tr>
              <% } %>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="2"><%= __('none') %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <%- include('../fragments/footer') %>
</body>
</html>
