<h2>New Visit</h2>

<b>Pet</b>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Birth Date</th>
            <th>Type</th>
            <th>Owner</th>
        </tr>
    </thead>
    <tr>
        <td><%= pet.name %></td>
        <td><%= pet.birthDate %></td>
        <td><%= pet.type ? pet.type.name : '' %></td>
        <td><%= owner.firstName %> <%= owner.lastName %></td>
    </tr>
</table>

<form class="form-horizontal" method="post">
    <% function inputField(label, name, value, type='text') { 
        const error = errors && errors.find(e => e.path === name);
    %>
    <div class="form-group mb-3 <%= error ? 'has-error' : '' %>">
        <label class="col-sm-2 control-label"><%= label %></label>
        <div class="col-sm-10">
            <input class="form-control" type="<%= type %>" name="<%= name %>" value="<%= value || '' %>" />
            <% if (error) { %>
                <span class="help-inline text-danger"><%= error.msg %></span>
            <% } %>
        </div>
    </div>
    <% } %>

    <% inputField('Date', 'date', visit.date, 'date') %>
    <% inputField('Description', 'description', visit.description) %>

    <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10">
            <button class="btn btn-primary" type="submit">Add Visit</button>
        </div>
    </div>
</form>

<br />
<b>Previous Visits</b>
<table class="table table-striped">
    <tr>
        <th>Date</th>
        <th>Description</th>
    </tr>
    <% if(pet.visits) { %>
        <% pet.visits.forEach(function(v) { %>
            <% if (!visit.id || v.id !== visit.id) { // Don't show current being created %>
            <tr>
                <td><%= v.date %></td>
                <td><%= v.description %></td>
            </tr>
            <% } %>
        <% }); %>
    <% } %>
</table>
