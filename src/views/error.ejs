<!DOCTYPE html>

<html lang="en">
<%- include('fragments/layout', { template: 'error', menu: 'error', i18n: i18n, t: t }) %>

<body>
  <img src="/static/images/pets.png" alt="Pets image" />
  <!-- Title: Something happened -->
  <h2 class="mt-4"><%= t('somethingHappened') %></h2>

  <!-- Status-specific error message -->
  <p>
    <% if (status === 404) { %>
      <%= t('error.404') %>
    <% } else if (status === 500) { %>
      <%= t('error.500') %>
    <% } else { %>
      <%= t('error.general') %>
    <% } %>
  </p>

  <!-- Exception message (for developers) -->
  <p><%- message %></p>
  <% if (stack) { %>
    <pre><code><%- stack %></code></pre>
  <% } %>
</body>

</html>
