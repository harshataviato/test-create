<!-- This view extends the main layout, injecting its content into the `<%- body %>` placeholder in `layout.ejs` -->
<%- layout('layout') %>

<!-- Display error message if present -->
<% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
    <div class="message error">
        <%= errorMessage %>
    </div>
<% } %>

<h2>Create New Product</h2>

<!-- Form for submitting new product details -->
<form action="/products/create" method="POST">
    <div class="form-group">
        <label for="name">Product Name:</label>
        <!-- Pre-fill input with oldInput.name if available (e.g., after an error) -->
        <input type="text" id="name" name="name" value="<%= typeof oldInput !== 'undefined' ? oldInput.name : '' %>" required>
    </div>
    <div class="form-group">
        <label for="description">Description:</label>
        <!-- Pre-fill textarea with oldInput.description if available -->
        <textarea id="description" name="description" rows="4" required><%= typeof oldInput !== 'undefined' ? oldInput.description : '' %></textarea>
    </div>
    <div class="form-group">
        <label for="price">Price:</label>
        <!-- Pre-fill input with oldInput.price if available -->
        <input type="number" id="price" name="price" step="0.01" min="0" value="<%= typeof oldInput !== 'undefined' ? oldInput.price : '' %>" required>
    </div>
    <button type="submit">Add Product</button>
</form>
