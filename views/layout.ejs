<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <link rel="icon" href="/resources/images/favicon.png"/>
  <title>PetClinic</title>

  <!-- Bootstrap core CSS -->
  <link href="/webjars/bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome -->
  <link href="/webjars/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <!-- Custom styles for this template -->
  <link href="/resources/css/petclinic.css" rel="stylesheet"/>

  <!-- Moment.js for date formatting -->
  <script src="/webjars/moment/2.30.1/moment.min.js"></script>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">
        <img src="/resources/images/logo.png" alt="PetClinic Logo" style="height: 30px;"> PetClinic
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item">
            <a class="nav-link" href="/"><i class="fa fa-home"></i> <%= __('menu.home') %></a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/owners/find"><i class="fa fa-search"></i> <%= __('menu.findOwners') %></a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/vets"><i class="fa fa-th-list"></i> <%= __('menu.veterinarians') %></a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/oups"><i class="fa fa-times"></i> <%= __('menu.error') %></a>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fa fa-globe"></i> <%= __('locale.change') %>
            </a>
            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
              <li><a class="dropdown-item" href="/locale?lang=en">English</a></li>
              <li><a class="dropdown-item" href="/locale?lang=de">Deutsch</a></li>
              <li><a class="dropdown-item" href="/locale?lang=es">Español</a></li>
            </ul>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container-fluid">
    <div class="container xd-container">
      <% if (locals.messages && messages.length > 0) { %>
        <div class="alert alert-success mt-3" role="alert">
          <%= messages.join(', ') %>
        </div>
      <% } %>
      <% if (locals.errors && errors.length > 0) { %>
        <div class="alert alert-danger mt-3" role="alert">
          <% if (Array.isArray(errors)) { %>
            <% errors.forEach(err => { %>
              <p><%= err.msg || err %></p>
            <% }); %>
          <% } else { %>
            <p><%= errors %></p>
          <% } %>
        </div>
      <% } %>

      <%- body %> <!-- This is where the specific view content will be injected -->

      <div class="container">
        <img src="/resources/images/banner-q.png" class="img-fluid" alt="banner"/>
      </div>
    </div>
  </div>

  <script src="/webjars/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
</body>
</html>
