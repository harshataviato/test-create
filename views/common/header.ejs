<!DOCTYPE html>
<html lang="<%= currentLocale %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | <%= __('common.appName') %></title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjC+RzWjD4/Nf4QWnQWkFm" crossorigin="anonymous">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-success">
        <div class="container-fluid">
            <a class="navbar-brand" href="/"><%= __('common.appName') %></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'home' ? 'active' : '' %>" href="/"><%= __('common.home') %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'owners' ? 'active' : '' %>" href="/owners/find"><%= __('common.owners') %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'vets' ? 'active' : '' %>" href="/vets"><%= __('common.veterinarians') %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'error' ? 'active' : '' %>" href="/oups"><%= __('common.error') %> Simulation</a>
                    </li>
                </ul>
                <div class="lang-switcher d-flex align-items-center">
                    <span class="me-2"><%= __('common.language') %>:</span>
                    <a href="?lang=en" class="mx-1 <%= currentLocale === 'en' ? 'active-lang' : '' %>">EN</a>
                    <a href="?lang=es" class="mx-1 <%= currentLocale === 'es' ? 'active-lang' : '' %>">ES</a>
                </div>
            </div>
        </div>
    </nav>
    <div class="container-fluid mt-4">
