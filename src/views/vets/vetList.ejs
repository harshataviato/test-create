<% extend('../fragments/layout') %>
<h2><%= __('vets') %></h2>

<table id="vets" class="table table-striped">
    <thead>
        <tr>
            <th><%= __('name') %></th>
            <th><%= __('specialties') %></th>
        </tr>
    </thead>
    <tbody>
        <% listVets.forEach(vet => { %>
        <tr>
            <td><%= vet.firstName %> <%= vet.lastName %></td>
            <td>
                <% if (vet.Specialties.length > 0) { %>
                    <%= vet.Specialties.map(s => s.name).join(', ') %>
                <% } else { %>
                    <%= __('none') %>
                <% } %>
            </td>
        </tr>
        <% }) %>
    </tbody>
</table>
