<%
  const moment = require('moment');
%>
<%- include('../layout', { body: `
  <h2>${pet.id ? 'Update' : 'New'} Pet</h2>
  
  <form class="form-horizontal" method="post" action="${pet.id ? '/owners/'+owner.id+'/pets/'+pet.id+'/edit' : '/owners/'+owner.id+'/pets/new'}">
    
    <input type="hidden" name="id" value="${pet.id || ''}" />
    
    <% if (locals.errors) { %>
      <div class="alert alert-danger">
        <ul>
          <% errors.forEach(function(error) { %>
            <li>${error.path}: ${error.msg}</li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <div class="form-group row mb-3">
      <label class="col-sm-2 col-form-label">Owner</label>
      <div class="col-sm-10">
        <span class="form-control-plaintext">${owner.firstName} ${owner.lastName}</span>
      </div>
    </div>

    <div class="form-group row mb-3">
      <label class="col-sm-2 col-form-label">Name</label>
      <div class="col-sm-10">
        <input type="text" class="form-control" name="name" value="${pet.name || ''}" />
      </div>
    </div>

    <div class="form-group row mb-3">
      <label class="col-sm-2 col-form-label">Birth Date</label>
      <div class="col-sm-10">
        <input type="date" class="form-control" name="birthDate" value="${pet.birthDate ? moment(pet.birthDate).format('YYYY-MM-DD') : ''}" />
      </div>
    </div>

    <div class="form-group row mb-3">
      <label class="col-sm-2 col-form-label">Type</label>
      <div class="col-sm-10">
        <select class="form-select" name="typeId">
          <% types.forEach(function(type) { %>
            <option value="${type.id}" ${pet.typeId == type.id ? 'selected' : ''}>${type.name}</option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="form-group row">
      <div class="col-sm-offset-2 col-sm-10">
        <button class="btn btn-primary" type="submit">
          ${pet.id ? 'Update Pet' : 'Add Pet'}
        </button>
      </div>
    </div>
  </form>
` }) %>
