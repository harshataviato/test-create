<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Product Management</title>
    <style>
        body { font-family: Arial, sans-serif; text-align: center; margin-top: 50px; }
        h1 { color: #dc3545; }
        p { color: #6c757d; }
        .error-message { font-style: italic; color: #333; }
        a { color: #007bff; text-decoration: none; }
        a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <h1><%= title %></h1>
    <p>We apologize, but something went wrong on our server.</p>
    <% if (typeof message !== 'undefined' && message) { %>
        <p class="error-message">Error Details: <%= message %></p>
    <% } %>
    <p><a href="/products">Go to Products List</a></p>
</body>
</html>
