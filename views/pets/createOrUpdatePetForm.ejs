<% var activePage = 'owners'; %>
<% 
var content = `
    <h2>${pet.id ? 'Pet' : 'New Pet'}</h2>
    <form class="form-horizontal" method="post">
        <div class="form-group row mb-3">
            <label class="col-sm-2 col-form-label">Owner</label>
            <div class="col-sm-10 pt-2">
                <span>${owner.firstName} ${owner.lastName}</span>
            </div>
        </div>
        
        <div class="form-group row mb-3">
            <label class="col-sm-2 col-form-label">Name</label>
            <div class="col-sm-10">
                <input type="text" class="form-control ${errors && errors.name ? 'is-invalid' : ''}" name="name" value="${pet.name || ''}" />
                ${errors && errors.name ? '<div class="invalid-feedback">' + errors.name.msg + '</div>' : ''}
            </div>
        </div>

        <div class="form-group row mb-3">
            <label class="col-sm-2 col-form-label">Birth Date</label>
            <div class="col-sm-10">
                <input type="date" class="form-control ${errors && errors.birthDate ? 'is-invalid' : ''}" name="birthDate" value="${pet.birthDate || ''}" />
                ${errors && errors.birthDate ? '<div class="invalid-feedback">' + errors.birthDate.msg + '</div>' : ''}
            </div>
        </div>

        <div class="form-group row mb-3">
            <label class="col-sm-2 col-form-label">Type</label>
            <div class="col-sm-10">
                <select class="form-control ${errors && errors.type ? 'is-invalid' : ''}" name="type">
                    ${types.map(t => `<option value="${t.name}" ${pet.type === t.name ? 'selected' : ''}>${t.name}</option>`).join('')}
                </select>
                ${errors && errors.type ? '<div class="invalid-feedback">' + errors.type.msg + '</div>' : ''}
            </div>
        </div>

        <div class="form-group row mb-3">
            <div class="col-sm-offset-2 col-sm-10">
                <button class="btn btn-primary" type="submit">${pet.id ? 'Update Pet' : 'Add Pet'}</button>
            </div>
        </div>
    </form>
`;
var body = content;
%>
<%- include('../layout', {body: body, activePage: activePage}) %>
