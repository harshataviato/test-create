{{!< layouts/main}}

<h2>
  {{#isNew visit}}{{i18n new}}{{/isNew}} Visit
</h2>

<b>{{i18n petTitle}}</b>
<table class="table table-striped">
  <thead>
    <tr>
      <th>{{i18n name}}</th>
      <th>{{i18n birthDate}}</th>
      <th>{{i18n type}}</th>
      <th>{{i18n ownerLabel}}</th>
    </tr>
  </thead>
  <tr>
    <td>{{pet.name}}</td>
    <td>{{#temporals.format pet.birthDate 'YYYY-MM-DD'}}</td>
    <td>{{pet.type.name}}</td>
    <td>{{owner.firstName}} {{owner.lastName}}</td>
  </tr>
</table>

<form action="/owners/{{owner.id}}/pets/{{pet.id}}/visits/new" class="form-horizontal" method="post">
  <div class="form-group has-feedback">
    {{> partials/inputField label="date" name="date" type="date" defaultValue=visit.date errors=errors}}
    {{> partials/inputField label="description" name="description" type="text" defaultValue=visit.description errors=errors}}
  </div>

  <div class="form-group">
    <div class="col-sm-offset-2 col-sm-10">
      <input type="hidden" name="petId" value="{{pet.id}}" />
      <button class="btn btn-primary" type="submit">{{i18n addVisit}}</button>
    </div>
  </div>
</form>

<br />
<b>{{i18n previousVisits}}</b>
<table class="table table-striped">
  <thead>
    <tr>
      <th>{{i18n date}}</th>
      <th>{{i18n description}}</th>
    </tr>
  </thead>
  {{#if pet.visits}}
    {{#each pet.visits}}
      {{#unless (isNew this)}}
        <tr>
          <td>{{#temporals.format this.date 'YYYY-MM-DD'}}</td>
          <td>{{this.description}}</td>
        </tr>
      {{/unless}}
    {{/each}}
  {{/if}}
</table>
