<%- layout('layout') %>
<!-- views/tasks/new.ejs -->
<!-- This view provides a form for creating a new task. -->

<h2><%= title %></h2>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="message error">
        <%= error %>
    </div>
<% } %>

<form action="/tasks" method="POST">
    <div>
        <label for="title">Task Title:</label>
        <!-- The 'value' attribute is pre-filled if 'task.title' exists (e.g., after a validation error) -->
        <input type="text" id="title" name="title" value="<%= typeof task !== 'undefined' ? task.title : '' %>" required>
    </div>
    <div>
        <label for="description">Description:</label>
        <!-- The content inside textarea tags is pre-filled -->
        <textarea id="description" name="description" rows="5"><%= typeof task !== 'undefined' ? task.description : '' %></textarea>
    </div>
    <div>
        <button type="submit" class="btn">Create Task</button>
        <a href="/tasks" class="btn btn-secondary">Cancel</a>
    </div>
</form>
