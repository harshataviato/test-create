<%- include('../layout/header') %>

<h2><%= pet.id ? 'Pet' : 'New Pet' %></h2>

<form class="form-horizontal" method="post">
    <div class="form-group row mb-3">
        <label class="col-sm-2 col-form-label">Owner</label>
        <div class="col-sm-10 pt-2">
            <span><%= owner.firstName %> <%= owner.lastName %></span>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-sm-2 col-form-label">Name</label>
        <div class="col-sm-10">
            <input class="form-control" type="text" name="name" value="<%= pet.name || '' %>" />
            <% if (locals.errors && errors.name) { %>
                <span class="text-danger"><%= errors.name %></span>
            <% } %>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-sm-2 col-form-label">Birth Date</label>
        <div class="col-sm-10">
            <input class="form-control" type="date" name="birthDate" value="<%= pet.birthDate || '' %>" />
            <% if (locals.errors && errors.birthDate) { %>
                <span class="text-danger"><%= errors.birthDate %></span>
            <% } %>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-sm-2 col-form-label">Type</label>
        <div class="col-sm-10">
            <select class="form-control" name="type">
                <% types.forEach(function(t) { %>
                    <option value="<%= t.name %>" <%= (pet.type === t.name) ? 'selected' : '' %>><%= t.name %></option>
                <% }); %>
            </select>
        </div>
    </div>

    <div class="form-group row mb-3">
        <div class="col-sm-offset-2 col-sm-10">
            <button class="btn btn-primary" type="submit"><%= pet.id ? 'Update Pet' : 'Add Pet' %></button>
        </div>
    </div>
</form>

<%- include('../layout/footer') %>
