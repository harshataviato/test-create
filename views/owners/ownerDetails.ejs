<% var activePage = 'owners'; %>
<% 
var content = `
    <h2>Owner Information</h2>

    <table class="table table-striped">
        <tr>
            <th>Name</th>
            <td><b>${owner.firstName} ${owner.lastName}</b></td>
        </tr>
        <tr>
            <th>Address</th>
            <td>${owner.address}</td>
        </tr>
        <tr>
            <th>City</th>
            <td>${owner.city}</td>
        </tr>
        <tr>
            <th>Telephone</th>
            <td>${owner.telephone}</td>
        </tr>
    </table>

    <a href="/owners/${owner.id}/edit" class="btn btn-primary">Edit Owner</a>
    <a href="/owners/${owner.id}/pets/new" class="btn btn-primary">Add New Pet</a>

    <br /><br /><br />
    <h2>Pets and Visits</h2>

    <table class="table table-striped">
        ${owner.pets && owner.pets.length > 0 ? owner.pets.map(pet => `
            <tr>
                <td valign="top" style="width: 30%;">
                    <dl class="row">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">${pet.name}</dd>
                        <dt class="col-sm-4">Birth Date</dt>
                        <dd class="col-sm-8">${pet.birthDate}</dd>
                        <dt class="col-sm-4">Type</dt>
                        <dd class="col-sm-8">${pet.type ? pet.type.name : ''}</dd>
                    </dl>
                </td>
                <td valign="top">
                    <table class="table-condensed">
                        <thead>
                            <tr>
                                <th>Visit Date</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${pet.visits ? pet.visits.map(visit => `
                                <tr>
                                    <td>${visit.date}</td>
                                    <td>${visit.description}</td>
                                </tr>
                            `).join('') : ''}
                            <tr>
                                <td><a href="/owners/${owner.id}/pets/${pet.id}/edit">Edit Pet</a></td>
                                <td><a href="/owners/${owner.id}/pets/${pet.id}/visits/new">Add Visit</a></td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        `).join('') : ''}
    </table>
`;
var body = content;
%>
<%- include('../layout', {body: body, activePage: activePage}) %>
