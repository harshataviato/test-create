<%- include('../layout', { body: `
  <h2>New Visit</h2>

  <b>Pet</b>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Name</th>
        <th>Birth Date</th>
        <th>Type</th>
        <th>Owner</th>
      </tr>
    </thead>
    <tr>
      <td><%= pet.name %></td>
      <td><%= pet.birthDate %></td>
      <td><%= pet.type ? pet.type.name : '' %></td>
      <td><%= owner.firstName %> <%= owner.lastName %></td>
    </tr>
  </table>

  <form class="form-horizontal" method="post">
    <div class="form-group mb-2">
        <label class="col-sm-2 control-label">Date</label>
        <div class="col-sm-10">
            <input type="date" class="form-control" name="date" value="<%= visit.date || new Date().toISOString().split('T')[0] %>" />
            <% if (errors && errors.date) { %>
                <span class="help-inline text-danger"><%= errors.date.msg %></span>
            <% } %>
        </div>
    </div>

    <div class="form-group mb-2">
        <label class="col-sm-2 control-label">Description</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" name="description" value="<%= visit.description || '' %>" />
            <% if (errors && errors.description) { %>
                <span class="help-inline text-danger"><%= errors.description.msg %></span>
            <% } %>
        </div>
    </div>

    <div class="form-group mt-3">
        <div class="col-sm-offset-2 col-sm-10">
            <button class="btn btn-primary" type="submit">Add Visit</button>
        </div>
    </div>
  </form>

  <br />
  <b>Previous Visits</b>
  <table class="table table-striped">
    <tr>
      <th>Date</th>
      <th>Description</th>
    </tr>
    <% if (pet.visits) { %>
        <% pet.visits.forEach(function(v) { %>
            <% if (!visit.new || v.id) { %> 
            <tr>
                <td><%= v.date %></td>
                <td><%= v.description %></td>
            </tr>
            <% } %>
        <% }); %>
    <% } %>
  </table>
` }) %>
