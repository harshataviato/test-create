<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Sets the page title dynamically from the `pageTitle` variable passed to the view -->
    <title><%= pageTitle %></title>
    <!-- Link to a simple stylesheet for basic styling -->
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
            color: #333;
        }
        header {
            background-color: #333;
            color: #fff;
            padding: 1rem 0;
            text-align: center;
        }
        header nav ul {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            justify-content: center;
        }
        header nav ul li {
            margin: 0 15px;
        }
        header nav ul li a {
            color: #fff;
            text-decoration: none;
            font-weight: bold;
        }
        header nav ul li a:hover,
        header nav ul li a.active {
            color: #ffd700; /* Gold color for active/hover state */
        }
        main {
            padding: 20px;
            max-width: 900px;
            margin: 20px auto;
            background-color: #fff;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            border-radius: 8px;
        }
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }
        .form-group input[type="text"],
        .form-group input[type="number"],
        .form-group textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            box-sizing: border-box; /* Include padding in element's total width */
        }
        .form-group textarea {
            resize: vertical; /* Allow vertical resizing only */
            min-height: 80px;
        }
        button {
            background-color: #007bff;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 16px;
        }
        button:hover {
            background-color: #0056b3;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        table, th, td {
            border: 1px solid #ddd;
        }
        th, td {
            padding: 10px;
            text-align: left;
        }
        th {
            background-color: #f2f2f2;
        }
        .message.error {
            color: #dc3545;
            background-color: #f8d7da;
            border: 1px solid #f5c6cb;
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <!-- Header section with navigation -->
    <header>
        <h1>Product Management</h1>
        <nav>
            <ul>
                <!-- Navigation link for Product List -->
                <!-- The 'path' variable is passed from the controller to determine the active link -->
                <li><a href="/products" class="<%= path === '/products' ? 'active' : '' %>">Product List</a></li>
                <!-- Navigation link for Create Product -->
                <li><a href="/products/create" class="<%= path === '/products/create' ? 'active' : '' %>">Create Product</a></li>
            </ul>
        </nav>
    </header>

    <!-- Main content area -->
    <main>
        <!-- This is where the specific content of each view (e.g., product-create.ejs, product-list.ejs) will be injected -->
        <%- body %>
    </main>
</body>
</html>
