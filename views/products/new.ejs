<!-- Extends the base layout for common header, footer, etc. -->
<%- layout('layout') %>

<!-- Main content for the new product creation form -->
<div class="container form-container">
  <h2><%= title %></h2>

  <!-- Error message display for form-specific errors -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert error">
      <p><strong>Validation Error:</strong> <%= error %></p>
    </div>
  <% } %>

  <!-- Form to create a new product -->
  <!-- The action points to /products, which is handled by the POST /products route -->
  <form action="/products" method="POST">
    <div class="form-group">
      <label for="name">Product Name:</label>
      <!-- 'value' attribute can be pre-filled if there was an error and the form needs to retain input -->
      <input type="text" id="name" name="name" value="<%= typeof product !== 'undefined' ? product.name : '' %>" required>
    </div>

    <div class="form-group">
      <label for="description">Description:</label>
      <textarea id="description" name="description" rows="5"><%= typeof product !== 'undefined' ? product.description : '' %></textarea>
    </div>

    <div class="form-group">
      <label for="price">Price:</label>
      <input type="number" id="price" name="price" value="<%= typeof product !== 'undefined' ? product.price : '' %>" step="0.01" min="0" required>
    </div>

    <div class="form-group">
      <label for="quantity">Quantity:</label>
      <input type="number" id="quantity" name="quantity" value="<%= typeof product !== 'undefined' ? product.quantity : '' %>" min="0" required>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Create Product</button>
      <a href="/products" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
