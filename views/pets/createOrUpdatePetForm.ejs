<h2>
    <%= mode === 'create' ? 'New' : 'Update' %> Pet
</h2>

<form class="form-horizontal" method="post">
    <div class="form-group mb-3">
        <label class="col-sm-2 control-label">Owner</label>
        <div class="col-sm-10">
            <span class="form-control-plaintext"><%= owner.firstName %> <%= owner.lastName %></span>
        </div>
    </div>

    <div class="form-group mb-3 <%= locals.errors && errors.name ? 'has-error' : '' %>">
        <label class="col-sm-2 control-label">Name</label>
        <div class="col-sm-10">
            <input class="form-control" type="text" name="name" value="<%= pet.name || '' %>" />
            <% if (locals.errors && errors.name) { %>
                <span class="help-inline text-danger"><%= errors.name.msg %></span>
            <% } %>
        </div>
    </div>

    <div class="form-group mb-3 <%= locals.errors && errors.birthDate ? 'has-error' : '' %>">
        <label class="col-sm-2 control-label">Birth Date</label>
        <div class="col-sm-10">
            <input class="form-control" type="date" name="birthDate" value="<%= pet.birthDate || '' %>" />
            <% if (locals.errors && errors.birthDate) { %>
                <span class="help-inline text-danger"><%= errors.birthDate.msg %></span>
            <% } %>
        </div>
    </div>

    <div class="form-group mb-3 <%= locals.errors && errors.typeId ? 'has-error' : '' %>">
        <label class="col-sm-2 control-label">Type</label>
        <div class="col-sm-10">
            <select name="typeId" class="form-control">
                <% types.forEach(function(type) { %>
                    <option value="<%= type.id %>" <%= (pet.typeId == type.id) ? 'selected' : '' %>>
                        <%= type.name %>
                    </option>
                <% }); %>
            </select>
            <% if (locals.errors && errors.typeId) { %>
                <span class="help-inline text-danger"><%= errors.typeId.msg %></span>
            <% } %>
        </div>
    </div>

    <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10">
            <button class="btn btn-primary" type="submit">
                <%= mode === 'create' ? 'Add Pet' : 'Update Pet' %>
            </button>
        </div>
    </div>
</form>
