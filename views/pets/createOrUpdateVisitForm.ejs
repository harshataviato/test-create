<!DOCTYPE html>
<html>
<%- include('../partials/header') %>
<body>
  <%- include('../partials/navbar') %>
  <div class="container xd-container">
    <h2>New Visit</h2>
    <b>Pet</b>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Name</th>
          <th>Birth Date</th>
          <th>Type</th>
          <th>Owner</th>
        </tr>
      </thead>
      <tr>
        <td><%= pet.name %></td>
        <td><%= moment(pet.birthDate).format('YYYY-MM-DD') %></td>
        <td><%= pet.type ? pet.type.name : (pet.PetType ? pet.PetType.name : '') %></td>
        <td><%= pet.Owner ? (pet.Owner.firstName + ' ' + pet.Owner.lastName) : '' %></td>
      </tr>
    </table>

    <form class="form-horizontal" method="post">
      <div class="form-group mb-3 <%= (locals.errors && errors.date) ? 'has-error' : '' %>">
        <label class="col-sm-2 control-label">Date</label>
        <div class="col-sm-10">
          <input class="form-control" type="date" name="date" value="<%= visit.date || moment().format('YYYY-MM-DD') %>" />
          <% if (locals.errors && errors.date) { %><span class="text-danger"><%= errors.date.msg %></span><% } %>
        </div>
      </div>

      <div class="form-group mb-3 <%= (locals.errors && errors.description) ? 'has-error' : '' %>">
        <label class="col-sm-2 control-label">Description</label>
        <div class="col-sm-10">
          <input class="form-control" type="text" name="description" value="<%= visit.description || '' %>" />
          <% if (locals.errors && errors.description) { %><span class="text-danger"><%= errors.description.msg %></span><% } %>
        </div>
      </div>

      <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10">
          <button class="btn btn-primary" type="submit">Add Visit</button>
        </div>
      </div>
    </form>

    <br />
    <b>Previous Visits</b>
    <table class="table table-striped">
      <tr>
        <th>Date</th>
        <th>Description</th>
      </tr>
      <% if(pet.visits) { %>
        <% pet.visits.forEach(function(v) { %>
          <% if (!v.isNewRecord) { // Basic check %>
          <tr>
            <td><%= moment(v.date).format('YYYY-MM-DD') %></td>
            <td><%= v.description %></td>
          </tr>
          <% } %>
        <% }); %>
      <% } %>
    </table>
  </div>
</body>
</html>
