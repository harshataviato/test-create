<%- include('../fragments/layout', { body: `
    <h2>${isNew ? 'New Pet' : 'Update Pet'}</h2>
    <p><b>Owner:</b> ${owner.firstName} ${owner.lastName}</p>
    <form method="post" class="form-horizontal">
        <div class="form-group">
            <label>Name</label>
            <input class="form-control" name="name" value="${pet.name || ''}" required />
        </div>
        <div class="form-group">
            <label>Birth Date</label>
            <input class="form-control" type="date" name="birthDate" value="${pet.birthDate || ''}" required />
        </div>
        <div class="form-group">
            <label>Type</label>
            <select name="typeId" class="form-control">
                ${types.map(t => `
                    <option value="${t.id}" ${pet.type_id == t.id ? 'selected' : ''}>${t.name}</option>
                `).join('')}
            </select>
        </div>
        <br/>
        <button type="submit" class="btn btn-primary">${isNew ? 'Add Pet' : 'Update Pet'}</button>
    </form>
` }) %>
