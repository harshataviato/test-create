<!DOCTYPE html>
<html>
<%- include('../partials/header') %>
<body>
  <%- include('../partials/navbar') %>
  <div class="container xd-container">
    <h2>Owners</h2>
    <table id="owners" class="table table-striped">
      <thead>
        <tr>
          <th style="width: 150px;">Name</th>
          <th style="width: 200px;">Address</th>
          <th>City</th>
          <th style="width: 120px">Telephone</th>
          <th>Pets</th>
        </tr>
      </thead>
      <tbody>
        <% listOwners.forEach(function(owner) { %>
          <tr>
            <td>
              <a href="/owners/<%= owner.id %>"><%= owner.firstName %> <%= owner.lastName %></a>
            </td>
            <td><%= owner.address %></td>
            <td><%= owner.city %></td>
            <td><%= owner.telephone %></td>
            <td>
              <% 
                // Eager loading pets not guaranteed in list view query for brevity, 
                // but if fetched, join names. Otherwise empty.
                // Note: The controller logic used simplified findAll without nested includes for the list
                // To display pets here properly, the controller query should include Pets.
              %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <!-- Simplified Pagination Display -->
    <% if (locals.totalPages && totalPages > 1) { %>
      <div>
        <span>Pages:</span>
        <span>[</span>
        <% for(let i=1; i <= totalPages; i++) { %>
          <a href="/owners?page=<%= i %>"><%= i %></a>
        <% } %>
        <span>]</span>
      </div>
    <% } %>
  </div>
</body>
</html>
