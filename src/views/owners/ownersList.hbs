<h2>Owners</h2>

<table class="table table-striped">
  <thead>
    <tr>
      <th style="width: 150px;">Name</th>
      <th style="width: 200px;">Address</th>
      <th>City</th>
      <th style="width: 120px">Telephone</th>
      <th>Pets</th>
    </tr>
  </thead>
  <tbody>
    {{#each listOwners}}
    <tr>
      <td><a href="/owners/{{this.id}}">{{this.firstName}} {{this.lastName}}</a></td>
      <td>{{this.address}}</td>
      <td>{{this.city}}</td>
      <td>{{this.telephone}}</td>
      <td>
        {{#each this.pets}}
          {{this.name}}{{#unless @last}}, {{/unless}}
        {{/each}}
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>
