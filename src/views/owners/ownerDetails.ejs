<%- include('../fragments/layout', { template: 'owner_details_content', menu: 'owners' }) %>

<% function owner_details_content() { %>
  <h2><%= i18n.__('ownerInformation') %></h2>

  <% if (locals.messages && locals.messages.success && locals.messages.success.length > 0) { %>
    <div class="alert alert-success" id="success-message">
      <span><%= locals.messages.success.join('<br>') %></span>
    </div>
  <% } %>

  <% if (locals.messages && locals.messages.error && locals.messages.error.length > 0) { %>
    <div class="alert alert-danger" id="error-message">
      <span><%= locals.messages.error.join('<br>') %></span>
    </div>
  <% } %>

  <table class="table table-striped">
    <tr>
      <th><%= i18n.__('name') %></th>
      <td><b><%= owner.firstName + ' ' + owner.lastName %></b></td>
    </tr>
    <tr>
      <th><%= i18n.__('address') %></th>
      <td><%= owner.address %></td>
    </tr>
    <tr>
      <th><%= i18n.__('city') %></th>
      <td><%= owner.city %></td>
    </tr>
    <tr>
      <th><%= i18n.__('telephone') %></th>
      <td><%= owner.telephone %></td>
    </tr>
  </table>

  <a href="/owners/<%= owner.id %>/edit" class="btn btn-primary"><%= i18n.__('editOwner') %></a>
  <a href="/owners/<%= owner.id %>/pets/new" class="btn btn-primary"><%= i18n.__('addNewPet') %></a>

  <br />
  <br />
  <br />
  <h2><%= i18n.__('petsAndVisits') %></h2>

  <table class="table table-striped">
    <% owner.pets.forEach(pet => { %>
      <tr>
        <td valign="top">
          <dl class="dl-horizontal">
            <dt><%= i18n.__('name') %></dt>
            <dd><%= pet.name %></dd>
            <dt><%= i18n.__('birthDate') %></dt>
            <dd><%= sequelize.ejs.moment(pet.birthDate).format('YYYY-MM-DD') %></dd>
            <dt><%= i18n.__('type') %></dt>
            <dd><%= pet.type ? pet.type.name : '' %></dd>
          </dl>
        </td>
        <td valign="top">
          <table class="table-condensed">
            <thead>
              <tr>
                <th><%= i18n.__('visitDate') %></th>
                <th><%= i18n.__('description') %></th>
              </tr>
            </thead>
            <% if (pet.visits && pet.visits.length > 0) { %>
              <% pet.visits.forEach(visit => { %>
                <tr>
                  <td><%= sequelize.ejs.moment(visit.visitDate).format('YYYY-MM-DD') %></td>
                  <td><%= visit.description %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="2"><%= i18n.__('none') %></td>
              </tr>
            <% } %>
            <tr>
              <td><a href="/owners/<%= owner.id %>/pets/<%= pet.id %>/edit"><%= i18n.__('editPet') %></a></td>
              <td><a href="/owners/<%= owner.id %>/pets/<%= pet.id %>/visits/new"><%= i18n.__('addVisit') %></a></td>
            </tr>
          </table>
        </td>
      </tr>
    <% }); %>
  </table>
  <script>
    // Function to hide the success and error messages after 3 seconds
    function hideMessages() {
      setTimeout(function () {
        const successMessage = document.getElementById("success-message");
        const errorMessage = document.getElementById("error-message");
        if (successMessage) successMessage.style.display = "none";
        if (errorMessage) errorMessage.style.display = "none";
      }, 3000); // 3000 milliseconds (3 seconds)
    }

    // Call the function to hide messages when the DOM is fully loaded
    document.addEventListener('DOMContentLoaded', hideMessages);
  </script>
<% } %>
