<!DOCTYPE html>

<html lang="en">
<%- include('../fragments/layout', { template: 'vets/vetList', menu: 'vets', i18n: i18n, t: t, listVets: listVets, totalPages: totalPages, currentPage: currentPage }) %>

<body>

  <h2 class="mt-4"><%= t('vets') %></h2>

  <table id="vets" class="table table-striped mt-3">
    <thead>
      <tr>
        <th><%= t('name') %></th>
        <th><%= t('specialties') %></th>
      </tr>
    </thead>
    <tbody>
      <% listVets.forEach(function(vet) { %>
        <tr>
          <td><%= vet.firstName %> <%= vet.lastName %></td>
          <td>
            <% if (vet.specialties && vet.specialties.length > 0) { %>
              <%= vet.specialties.map(s => s.name).join(', ') %>
            <% } else { %>
              <%= t('none') %>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <% if (totalPages > 1) { %>
    <div class="pagination-controls mt-3">
      <span><%= t('pages') %>:</span>
      <span>[</span>
      <% for (let i = 1; i <= totalPages; i++) { %>
        <% if (currentPage !== i) { %>
          <a href="/vets.html?page=<%= i %>"><%= i %></a>
        <% } else { %>
          <span><%= i %></span>
        <% } %>
      <% } %>
      <span>]&nbsp;</span>
      <span>
        <% if (currentPage > 1) { %>
          <a href="/vets.html?page=1" title="<%= t('first') %>" class="fa fa-fast-backward"></a>
        <% } else { %>
          <span class="fa fa-fast-backward disabled" title="<%= t('first') %>"></span>
        <% } %>
      </span>
      <span>
        <% if (currentPage > 1) { %>
          <a href="/vets.html?page=<%= currentPage - 1 %>" title="<%= t('previous') %>" class="fa fa-step-backward"></a>
        <% } else { %>
          <span class="fa fa-step-backward disabled" title="<%= t('previous') %>"></span>
        <% } %>
      </span>
      <span>
        <% if (currentPage < totalPages) { %>
          <a href="/vets.html?page=<%= currentPage + 1 %>" title="<%= t('next') %>" class="fa fa-step-forward"></a>
        <% } else { %>
          <span class="fa fa-step-forward disabled" title="<%= t('next') %>"></span>
        <% } %>
      </span>
      <span>
        <% if (currentPage < totalPages) { %>
          <a href="/vets.html?page=<%= totalPages %>" title="<%= t('last') %>" class="fa fa-fast-forward"></a>
        <% } else { %>
          <span class="fa fa-fast-forward disabled" title="<%= t('last') %>"></span>
        <% } %>
      </span>
    </div>
  <% } %>

</body>

</html>
