<%- include('../fragments/layout', { body: `
    <h2>${__('findOwners')}</h2>
    <form action="/owners" method="get" class="form-horizontal">
        <div class="form-group">
            <label class="col-sm-2 control-label">${__('lastName')}</label>
            <div class="col-sm-10">
                <input class="form-control" name="lastName" value="${owner.lastName || ''}" />
                ${typeof errors !== 'undefined' ? errors.map(e => `<span class="help-inline">${e.msg}</span>`).join('') : ''}
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
                <button type="submit" class="btn btn-primary">${__('findOwners')}</button>
            </div>
        </div>
        <a class="btn btn-primary" href="/owners/new">${__('addOwner')}</a>
    </form>
`}) %>
