<%- include('../fragments/layout', { template: 'vetListBody', menu: 'vets', i18n: i18n, req: req }) %>

<%~ contentFor('vetListBody') %>
  <h2><%= i18n.t('messages.vets', { lang: req.i18nLang }) %></h2>

  <table id="vets" class="table table-striped">
    <thead>
      <tr>
        <th><%= nameLabel %></th>
        <th><%= specialtiesLabel %></th>
      </tr>
    </thead>
    <tbody>
      <% listVets.forEach(vet => { %>
        <tr>
          <td><%= vet.firstName + ' ' + vet.lastName %></td>
          <td>
            <% if (vet.specialties && vet.specialties.length > 0) { %>
              <%= vet.specialties.map(s => s.name).join(' ') %>
            <% } else { %>
              <span><%= noneLabel %></span>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <% if (totalPages > 1) { %>
    <div class="pagination-controls">
      <span><%= pagesLabel %>:</span>
      <span>[</span>
      <% for (let i = 1; i <= totalPages; i++) { %>
        <% if (currentPage !== i) { %>
          <a href="/vets.html?page=<%= i %>"><%= i %></a>
        <% } else { %>
          <span><%= i %></span>
        <% } %>
      <% } %>
      <span>]&nbsp;</span>
      <span>
        <% if (currentPage > 1) { %>
          <a href="/vets.html?page=1" title="<%= firstLabel %>" class="fa fa-fast-backward"></a>
        <% } else { %>
          <span title="<%= firstLabel %>" class="fa fa-fast-backward disabled"></span>
        <% } %>
      </span>
      <span>
        <% if (currentPage > 1) { %>
          <a href="/vets.html?page=<%= currentPage - 1 %>" title="<%= previousLabel %>" class="fa fa-step-backward"></a>
        <% } else { %>
          <span title="<%= previousLabel %>" class="fa fa-step-backward disabled"></span>
        <% } %>
      </span>
      <span>
        <% if (currentPage < totalPages) { %>
          <a href="/vets.html?page=<%= currentPage + 1 %>" title="<%= nextLabel %>" class="fa fa-step-forward"></a>
        <% } else { %>
          <span title="<%= nextLabel %>" class="fa fa-step-forward disabled"></span>
        <% } %>
      </span>
      <span>
        <% if (currentPage < totalPages) { %>
          <a href="/vets.html?page=<%= totalPages %>" title="<%= lastLabel %>" class="fa fa-fast-forward"></a>
        <% } else { %>
          <span title="<%= lastLabel %>" class="fa fa-fast-forward disabled"></span>
        <% } %>
      </span>
    </div>
  <% } %>
