<%- include('../layout', { body: `
  <h2>Veterinarians</h2>

  <table id="vets" class="table table-striped">
    <thead>
      <tr>
        <th>Name</th>
        <th>Specialties</th>
      </tr>
    </thead>
    <tbody>
      <% listVets.forEach(function(vet) { %>
        <tr>
          <td>${vet.firstName} ${vet.lastName}</td>
          <td>
            <% if (vet.specialties && vet.specialties.length > 0) { %>
              <% vet.specialties.forEach(function(specialty) { %>
                <span>${specialty.name} </span>
              <% }); %>
            <% } else { %>
              <span>none</span>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
` }) %>
