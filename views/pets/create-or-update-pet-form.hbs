{{!< layouts/main}}

<h2>
  {{#isNew pet}}{{i18n new}}{{/isNew}} {{i18n petTitle}}
</h2>
<form action="/owners/{{owner.id}}/pets/{{#if pet.id}}{{pet.id}}/edit{{else}}new{{/if}}" class="form-horizontal" method="post">
  {{#if pet.id}}
    <input type="hidden" name="id" value="{{pet.id}}" />
  {{/if}}
  <div class="form-group has-feedback">
    <div class="form-group">
      <label class="col-sm-2 control-label">{{i18n ownerLabel}}</label>
      <div class="col-sm-10">
        <span>{{owner.firstName}} {{owner.lastName}}</span>
      </div>
    </div>
    {{> partials/inputField label="name" name="name" type="text" defaultValue=pet.name errors=errors}}
    {{> partials/inputField label="birthDate" name="birthDate" type="date" defaultValue=pet.birthDate errors=errors}}
    {{> partials/selectField label="type" name="type" items=types defaultValue=pet.type errors=errors}}
  </div>
  <div class="form-group">
    <div class="col-sm-offset-2 col-sm-10">
      <button class="btn btn-primary" type="submit">{{#isNew pet}}{{i18n addPet}}{{else}}{{i18n updatePet}}{{/isNew}}</button>
    </div>
  </div>
</form>
