<h2><%= messages.vets %></h2>

<table id="vets" class="table table-striped">
    <thead>
        <tr>
            <th><%= messages.name %></th>
            <th><%= messages.specialties %></th>
        </tr>
    </thead>
    <tbody>
        <% listVets.forEach(vet => { %>
            <tr>
                <td><%= vet.firstName %> <%= vet.lastName %></td>
                <td>
                    <% if (vet.Specialties && vet.Specialties.length > 0) { %>
                        <%= vet.Specialties.map(s => s.name).join(', ') %>
                    <% } else { %>
                        <%= messages.none %>
                    <% } %>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

<% if (totalPages > 1) { %>
    <nav>
        <ul class="pagination">
            <% for(let i=1; i <= totalPages; i++) { %>
                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                    <a class="page-link" href="/vets.html?page=<%= i %>"><%= i %></a>
                </li>
            <% } %>
        </ul>
    </nav>
<% } %>
