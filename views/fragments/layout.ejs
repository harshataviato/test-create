<!DOCTYPE html>
<html lang="<%= getLocale() %>">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="shortcut icon" type="image/x-icon" href="/resources/images/favicon.png">
  <title><%= __('layoutTitle') %></title>
  <link href="/webjars/font-awesome/css/font-awesome.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/resources/css/petclinic.css" />
</head>
<body>

  <nav class="navbar navbar-expand-lg navbar-dark" role="navigation">
    <div class="container-fluid">
      <a class="navbar-brand" href="/"><span></span></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navbar" aria-controls="main-navbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="main-navbar">
        <ul class="navbar-nav me-auto">
          <li class="nav-item">
            <a class="nav-link<%= menu === 'home' ? ' active' : '' %>" href="/" title="<%= __('home page') %>">
              <span class="fa fa-home"></span>
              <span><%= __('home') %></span>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link<%= menu === 'owners' ? ' active' : '' %>" href="/owners/find" title="<%= __('find owners') %>">
              <span class="fa fa-search"></span>
              <span><%= __('findOwners') %></span>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link<%= menu === 'vets' ? ' active' : '' %>" href="/vets.html" title="<%= __('veterinarians') %>">
              <span class="fa fa-th-list"></span>
              <span><%= __('vets') %></span>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link<%= menu === 'error' ? ' active' : '' %>" href="/oups" title="<%= __('trigger a RuntimeException to see how it is handled') %>">
              <span class="fa fa-exclamation-triangle"></span>
              <span><%= __('error') %></span>
            </a>
          </li>
          <!-- Language Selector -->
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownLang" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <%= getLocale().toUpperCase() %>
            </a>
            <ul class="dropdown-menu" aria-labelledby="navbarDropdownLang">
              <li><a class="dropdown-item" href="?lang=en">EN</a></li>
              <li><a class="dropdown-item" href="?lang=de">DE</a></li>
              <li><a class="dropdown-item" href="?lang=es">ES</a></li>
              <li><a class="dropdown-item" href="?lang=fa">FA</a></li>
              <li><a class="dropdown-item" href="?lang=ko">KO</a></li>
              <li><a class="dropdown-item" href="?lang=pt">PT</a></li>
              <li><a class="dropdown-item" href="?lang=ru">RU</a></li>
              <li><a class="dropdown-item" href="?lang=tr">TR</a></li>
            </ul>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container-fluid">
    <div class="container xd-container">

      <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert alert-success" id="success-message">
          <span><%= message %></span>
        </div>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" id="error-message">
          <span><%= error %></span>
        </div>
      <% } %>

      <% if (typeof noContent === 'undefined' || !noContent) { %>
        <%- yieldContent(template) %>
      <% } %>

      <br />
      <br />
      <div class="container">
        <div class="row">
          <div class="col-12 text-center">
            <img src="/resources/images/spring-logo.svg" alt="VMware Tanzu Logo" class="logo">
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/webjars/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Function to hide the success and error messages after 3 seconds
    function hideMessages() {
      const successMessage = document.getElementById("success-message");
      const errorMessage = document.getElementById("error-message");

      if (successMessage) {
        setTimeout(function () {
          successMessage.style.display = "none";
        }, 3000);
      }
      if (errorMessage) {
        setTimeout(function () {
          errorMessage.style.display = "none";
        }, 3000);
      }
    }

    // Call the function to hide messages when the page loads
    window.addEventListener('load', hideMessages);
  </script>
</body>
</html>
