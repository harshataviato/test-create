<%- include('../common/header', { title: __('owner.findOwnerTitle'), activePage: 'owners' }) %>

<div class="container my-4">
    <h2 class="mb-4"><%= __('owner.findOwnerTitle') %></h2>

    <form action="/owners" method="get" class="mb-4">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label for="lastName" class="form-label"><%= __('common.lastName') %></label>
                    <input type="text" class="form-control <%= errors.lastName ? 'is-invalid' : '' %>" id="lastName" name="lastName" value="<%= owner.lastName || '' %>">
                    <% if (errors.lastName) { %><div class="invalid-feedback"><%= errors.lastName.msg %></div><% } %>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-start">
            <button type="submit" class="btn btn-primary me-2"><%= __('owner.search') %></button>
            <a href="/owners/new" class="btn btn-success"><%= __('owner.addOwner') %></a>
        </div>
    </form>
</div>

<%- include('../common/footer') %>
