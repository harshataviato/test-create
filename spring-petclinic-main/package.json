{
  "name": "spring-petclinic-node",
  "version": "1.0.0",
  "description": "Node.js conversion of Spring PetClinic Sample Application",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "db:migrate": "sequelize db:migrate",
    "db:seed": "sequelize db:seed:all",
    "db:reset": "sequelize db:migrate:undo:all && sequelize db:migrate && sequelize db:seed:all",
    "test": "echo \"No tests specified yet\" && exit 0"
  },
  "keywords": [
    "nodejs",
    "express",
    "sequelize",
    "petclinic"
  ],
  "author": "Google Senior Engineer",
  "license": "Apache-2.0",
  "dependencies": {
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "i18n": "^0.15.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "mysql2": "^3.10.1",
    "node-cache": "^5.1.2",
    "nodemon": "^3.1.4",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2"
  }
}
