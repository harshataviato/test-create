<%- include('../partials/head') %>
<body>
  <%- include('../partials/navbar') %>
  <div class="container xd-container">

    <h2>New Visit</h2>

    <b>Pet</b>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Name</th>
          <th>Birth Date</th>
          <th>Type</th>
          <th>Owner</th>
        </tr>
      </thead>
      <tr>
        <td><%= pet.name %></td>
        <td><%= moment(pet.birthDate).format('YYYY-MM-DD') %></td>
        <td><%= pet.type ? pet.type.name : '' %></td>
        <td><%= owner.firstName %> <%= owner.lastName %></td>
      </tr>
    </table>

    <form class="form-horizontal" method="post">
      <% if (errors && errors.length > 0) { %>
        <div class="alert alert-danger">
          <% errors.forEach(function(error) { %>
            <p><%= error.msg %></p>
          <% }) %>
        </div>
      <% } %>

      <div class="form-group has-feedback">
        <div class="form-group">
          <label class="col-sm-2 control-label">Date</label>
          <div class="col-sm-10">
            <input class="form-control" type="date" name="date" value="<%= visit.date || moment().format('YYYY-MM-DD') %>" />
          </div>
        </div>
        <div class="form-group">
          <label class="col-sm-2 control-label">Description</label>
          <div class="col-sm-10">
            <input class="form-control" type="text" name="description" value="<%= visit.description || '' %>" />
          </div>
        </div>
      </div>

      <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10">
          <button class="btn btn-primary" type="submit">Add Visit</button>
        </div>
      </div>
    </form>

    <br />
    <b>Previous Visits</b>
    <table class="table table-striped">
      <tr>
        <th>Date</th>
        <th>Description</th>
      </tr>
      <% if(pet.visits) { %>
        <% pet.visits.forEach(function(v) { %>
          <tr>
            <td><%= moment(v.visitDate).format('YYYY-MM-DD') %></td>
            <td><%= v.description %></td>
          </tr>
        <% }) %>
      <% } %>
    </table>

  </div>
  <%- include('../partials/footer') %>
</body>
</html>
