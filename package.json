{
  "name": "petclinic-nodejs",
  "version": "1.0.0",
  "description": "A Node.js implementation of the PetClinic application.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "NODE_ENV=development nodemon app.js",
    "db:migrate": "node config/sequelize.js migrate",
    "db:seed": "node config/sequelize.js seed",
    "test": "NODE_ENV=test mocha --require test/setup.js --recursive --exit"
  },
  "keywords": [
    "nodejs",
    "express",
    "sequelize",
    "petclinic",
    "docker",
    "kubernetes"
  ],
  "author": "Google Senior Engineer",
  "license": "MIT",
  "dependencies": {
    "body-parser": "^1.20.2",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "i18n": "^0.15.1",
    "moment": "^2.30.1",
    "mysql2": "^3.10.0",
    "node-cache": "^5.1.2",
    "nodemon": "^3.1.2",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "chai": "^4.4.1",
    "mocha": "^10.4.0",
    "sinon": "^18.0.0",
    "supertest": "^7.0.0"
  }
}

