<%- include('../partials/header') %>

<h2>New Visit</h2>

<b>Pet</b>
<table class="table table-striped">
  <thead>
    <tr>
      <th>Name</th>
      <th>Birth Date</th>
      <th>Type</th>
      <th>Owner</th>
    </tr>
  </thead>
  <tr>
    <td><%= pet.name %></td>
    <td><%= moment(pet.birthDate).format('YYYY-MM-DD') %></td>
    <td><%= pet.type ? pet.type.name : '' %></td>
    <td><%= owner ? (owner.firstName + ' ' + owner.lastName) : '' %></td>
  </tr>
</table>

<form class="form-horizontal" method="post">
  <div class="form-group mb-2">
    <label class="col-sm-2 control-label">Date</label>
    <div class="col-sm-10">
      <input class="form-control" type="date" name="date" value="<%= visit.date || moment().format('YYYY-MM-DD') %>" />
      <% const errDate = (locals.errors || []).find(e => e.path === 'date'); %>
      <% if (errDate) { %> <span class="text-danger"><%= errDate.msg %></span> <% } %>
    </div>
  </div>

  <div class="form-group mb-2">
    <label class="col-sm-2 control-label">Description</label>
    <div class="col-sm-10">
      <input class="form-control" type="text" name="description" value="<%= visit.description || '' %>" />
      <% const errDesc = (locals.errors || []).find(e => e.path === 'description'); %>
      <% if (errDesc) { %> <span class="text-danger"><%= errDesc.msg %></span> <% } %>
    </div>
  </div>

  <div class="form-group mt-3">
    <div class="col-sm-offset-2 col-sm-10">
      <button class="btn btn-primary" type="submit">Add Visit</button>
    </div>
  </div>
</form>

<br />
<b>Previous Visits</b>
<table class="table table-striped">
  <tr>
    <th>Date</th>
    <th>Description</th>
  </tr>
  <% if (pet.visits) { %>
    <% pet.visits.forEach(function(v) { %>
      <% if (!v.new) { %>
      <tr>
        <td><%= moment(v.date).format('YYYY-MM-DD') %></td>
        <td><%= v.description %></td>
      </tr>
      <% } %>
    <% }); %>
  <% } %>
</table>

<%- include('../partials/footer') %>
