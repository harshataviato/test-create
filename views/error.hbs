<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{layoutTitle}}</title>
    <link rel="stylesheet" href="/resources/css/petclinic.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <div class="container-fluid">
        <div class="container xd-container">
            <img src="/resources/images/pets.png" alt="Pets Image" />
            <h2 class="error-title">{{somethingHappened}}</h2>

            <p>
                {{#eq status 404}}
                    <span>{{error404}}</span>
                {{else if (eq status 500)}}
                    <span>{{error500}}</span>
                {{else}}
                    <span>{{errorGeneral}}</span>
                {{/eq}}
            </p>

            {{#if message}}
                <p>{{message}}</p>
            {{/if}}

            <div class="row">
                <div class="col-12 text-center">
                    <img src="/resources/images/spring-logo.svg" alt="VMware Tanzu Logo" class="logo">
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
