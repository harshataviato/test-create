# Port for the Express application
PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=petclinic
DB_PASSWORD=petclinic
DB_NAME=petclinic

# Caching strategy for vets list
# Options: "memory" for in-memory NodeCache, "none" for no caching
CACHE_TYPE=memory

# Session secret for Express session middleware
SESSION_SECRET=supersecret
