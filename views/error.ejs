<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('fragments/layout', { template: '', menu: 'error', noContent: true }) %>
</head>
<body>
  <%- include('fragments/layout', { template: 'error_content', menu: 'error', noContent: false,
    status: status, message: message, stack: stack
  }) %>
</body>
</html>

<% /* This content block is included by the layout fragment */ %>
<% /* filename: views/error.ejs (content block) */ %>
<%- defineContent('error_content', () => { %>
  <img src="/resources/images/pets.png" alt="Pets">
  <!-- Title: Something happened -->
  <h2><%= __('somethingHappened') %></h2>

  <!-- Status-specific error message -->
  <p>
    <% if (status === 404) { %>
      <%= __('error.404') %>
    <% } else if (status === 500) { %>
      <%= __('error.500') %>
    <% } else { %>
      <%= __('error.general') %>
    <% } %>
  </p>

  <!-- Exception message (for developers) -->
  <p><%= message %></p>

  <% if (typeof stack !== 'undefined' && stack) { %>
    <pre><code><%= stack %></code></pre>
  <% } %>
<% }) %>
