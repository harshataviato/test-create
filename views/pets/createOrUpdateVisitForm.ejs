<%
  const moment = require('moment');
%>
<%- include('../layout', { body: `
  <h2>New Visit</h2>

  <b>Pet</b>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Name</th>
        <th>Birth Date</th>
        <th>Type</th>
        <th>Owner</th>
      </tr>
    </thead>
    <tr>
      <td>${pet.name}</td>
      <td>${moment(pet.birthDate).format('YYYY-MM-DD')}</td>
      <td>${pet.type ? pet.type.name : ''}</td>
      <td>${owner.firstName} ${owner.lastName}</td>
    </tr>
  </table>

  <form class="form-horizontal" method="post">
    
    <% if (locals.errors) { %>
      <div class="alert alert-danger">
        <ul>
          <% errors.forEach(function(error) { %>
            <li>${error.path}: ${error.msg}</li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <div class="form-group row mb-3">
      <label class="col-sm-2 col-form-label">Date</label>
      <div class="col-sm-10">
        <input type="date" class="form-control" name="date" value="${visit.date || moment().format('YYYY-MM-DD')}" />
      </div>
    </div>

    <div class="form-group row mb-3">
      <label class="col-sm-2 col-form-label">Description</label>
      <div class="col-sm-10">
        <input type="text" class="form-control" name="description" value="${visit.description || ''}" />
      </div>
    </div>

    <div class="form-group row">
      <div class="col-sm-offset-2 col-sm-10">
        <button class="btn btn-primary" type="submit">Add Visit</button>
      </div>
    </div>
  </form>

  <br />
  <b>Previous Visits</b>
  <table class="table table-striped">
    <tr>
      <th>Date</th>
      <th>Description</th>
    </tr>
    <% if (pet.visits) { %>
      <% pet.visits.forEach(function(v) { %>
        <% if (!visit.new) { %>
          <tr>
            <td>${moment(v.date).format('YYYY-MM-DD')}</td>
            <td>${v.description}</td>
          </tr>
        <% } %>
      <% }); %>
    <% } %>
  </table>
` }) %>
