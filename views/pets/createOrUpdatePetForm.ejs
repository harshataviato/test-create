<h2><%= pet.id ? 'Update' : 'New' %> Pet</h2>

<form class="form-horizontal" method="post">
    <div class="form-group mb-3">
        <label class="col-sm-2 control-label">Owner</label>
        <div class="col-sm-10">
            <span><%= owner.firstName %> <%= owner.lastName %></span>
        </div>
    </div>

    <% function inputField(label, name, value, type='text') { 
        const error = errors && errors.find(e => e.path === name);
    %>
    <div class="form-group mb-3 <%= error ? 'has-error' : '' %>">
        <label class="col-sm-2 control-label"><%= label %></label>
        <div class="col-sm-10">
            <input class="form-control" type="<%= type %>" name="<%= name %>" value="<%= value || '' %>" />
            <% if (error) { %>
                <span class="help-inline text-danger"><%= error.msg %></span>
            <% } %>
        </div>
    </div>
    <% } %>

    <% inputField('Name', 'name', pet.name) %>
    <% inputField('Birth Date', 'birthDate', pet.birthDate, 'date') %>

    <div class="form-group mb-3">
        <label class="col-sm-2 control-label">Type</label>
        <div class="col-sm-10">
            <select name="typeId" class="form-control">
                <% types.forEach(function(type) { %>
                    <option value="<%= type.id %>" <%= (pet.typeId == type.id || (pet.type && pet.type.id == type.id)) ? 'selected' : '' %>>
                        <%= type.name %>
                    </option>
                <% }); %>
            </select>
        </div>
    </div>

    <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10">
            <button class="btn btn-primary" type="submit">
                <%= pet.id ? 'Update Pet' : 'Add Pet' %>
            </button>
        </div>
    </div>
</form>
