{
  "name": "hello-world-node",
  "version": "1.0.0",
  "description": "A simple 'Hello World' application converted from Java to Node.js with an MVC structure.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --coverage --forceExit"
  },
  "keywords": [
    "node",
    "express",
    "hello-world",
    "mvc",
    "java-to-node"
  ],
  "author": "Google Senior Engineer",
  "license": "ISC",
  "dependencies": {
    "ejs": "^3.1.9",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "app.js",
      "controllers/**/*.js",
      "models/**/*.js"
    ]
  }
}

