// This file is a conceptual representation of what a 'package.json' might look like
// if the Spring PetClinic application were re-architected as a Node.js/TypeScript project.
// It is NOT a direct conversion of build.gradle, as build.gradle configures a Java build.
// This file defines metadata, scripts, and dependencies for a TypeScript project.
{
  "name": "spring-petclinic-main-ts",
  "version": "4.0.0-SNAPSHOT",
  "description": "Spring PetClinic Sample Application re-imagined with Node.js and TypeScript (conceptual)",
  "main": "dist/index.js",
  "scripts": {
    "start": "ts-node src/main.ts",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "db:mysql:up": "docker compose up mysql",
    "db:postgres:up": "docker compose up postgres"
    // In a pure TS project, Maven/Gradle tasks like `package`, `spring-boot:run`, `build-image`
    // would be replaced by Node.js equivalents:
    // - `build` (tsc for compilation, custom scripts for asset bundling/packaging)
    // - `start` (node dist/index.js or ts-node src/main.ts)
    // - Containerization would use Dockerfiles referencing Node.js builds.
    // - CSS compilation (if SCSS is used) would be handled by `sass` or webpack/vite config.
  },
  "keywords": [
    "spring",
    "petclinic",
    "typescript",
    "node.js",
    "express",
    "rest",
    "backend"
  ],
  "author": "Spring Projects (original concept), Google (TypeScript adaptation)",
  "license": "Apache-2.0",
  "dependencies": {
    // These are conceptual replacements/analogues for the Java dependencies.
    // A real conversion would involve selecting specific Node.js/TS libraries.
    // Example Java -> TypeScript equivalents:
    // - spring-boot-starter-webmvc    -> express, @types/express
    // - spring-boot-starter-data-jpa  -> typeorm, prisma, sequelize
    // - jakarta.validation            -> class-validator, class-transformer
    // - h2database, mysql-connector-j, postgresql -> sqlite3, mysql2, pg, respective drivers for ORM
    // - spring-boot-starter-cache     -> node-cache, redis, memcached client
    // - thymeleaf                     -> ejs, pug, handlebars (if server-side rendering) or React/Vue/Angular (for SPA)
    // - jakarta.xml.bind              -> xml2js, fast-xml-parser
    "express": "^4.19.2",
    "reflect-metadata": "^0.2.2",      // Required for some ORMs/dependency injection
    "class-validator": "^0.14.1",     // For validation
    "class-transformer": "^0.5.1",    // For DTO transformation (often used with class-validator)
    "typeorm": "^0.3.20",             // Example ORM
    "sqlite3": "^5.1.7",              // Example database driver (for H2 equivalent)
    "mysql2": "^3.9.7",               // Example database driver for MySQL
    "pg": "^8.11.5",                  // Example database driver for PostgreSQL
    "node-cache": "^5.1.2",           // Simple in-memory cache
    "helmet": "^7.1.0",               // Security headers
    "compression": "^1.7.4",          // Gzip compression
    "dotenv": "^16.4.5",              // Environment variable management
    // Webjars for frontend assets (if still serving static assets from backend)
    "bootstrap": "^5.3.3",
    "@fortawesome/fontawesome-free": "^6.5.2"
    // Note: If using a modern frontend framework (React/Vue/Angular), these webjar dependencies
    // would typically be managed directly by the frontend's package.json.
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/express": "^4.17.21",
    "@types/node-cache": "^4.2.10",
    "@types/adm-zip": "^0.5.5",      // For mvnw.ts/gradlew.ts wrapper logic
    "@types/node-fetch": "^2.6.11",   // For mvnw.ts wrapper logic
    "@types/compression": "^1.7.5",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "ts-node": "^10.9.2",             // For running TS directly without prior compilation
    "typescript": "^5.4.5",
    "eslint": "^8.57.0",              // Linter (replacement for Checkstyle)
    "prettier": "^3.2.5",             // Code formatter (replacement for Spring Java Format)
    "jest": "^29.7.0",                // Test runner (replacement for JUnit)
    "supertest": "^7.0.0",            // For API testing
    "nodemon": "^3.1.0",              // For development auto-restarts
    "node-fetch": "^2.6.11",          // For mvnw.ts wrapper logic (legacy CJS version)
    "adm-zip": "^0.5.12"              // For mvnw.ts wrapper logic
  }
}
