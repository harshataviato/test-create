<%- include('../layout', { body: `
  <h2>Owner</h2>
  <form class="form-horizontal" method="post">
    <% 
      const fields = [
        { name: 'firstName', label: 'First Name' },
        { name: 'lastName', label: 'Last Name' },
        { name: 'address', label: 'Address' },
        { name: 'city', label: 'City' },
        { name: 'telephone', label: 'Telephone' }
      ];
    %>
    
    <% fields.forEach(function(f) { %>
      <div class="form-group mb-2">
        <label class="col-sm-2 control-label"><%= f.label %></label>
        <div class="col-sm-10">
          <input type="text" class="form-control" name="<%= f.name %>" value="<%= owner[f.name] || '' %>" />
          <% if (errors && errors[f.name]) { %>
            <span class="help-inline text-danger"><%= errors[f.name].msg %></span>
          <% } %>
        </div>
      </div>
    <% }); %>

    <div class="form-group mt-3">
      <div class="col-sm-offset-2 col-sm-10">
        <button class="btn btn-primary" type="submit">
          <%= owner.id ? 'Update Owner' : 'Add Owner' %>
        </button>
      </div>
    </div>
  </form>
` }) %>
