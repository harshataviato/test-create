<h2>Owners</h2>

<table id="owners" class="table table-striped">
  <thead>
    <tr>
      <th style="width: 150px;">Name</th>
      <th style="width: 200px;">Address</th>
      <th>City</th>
      <th style="width: 120px">Telephone</th>
      <th>Pets</th>
    </tr>
  </thead>
  <tbody>
    {{#each listOwners}}
    <tr>
      <td>
        <a href="/owners/{{this.id}}">{{this.firstName}} {{this.lastName}}</a>
      </td>
      <td>{{this.address}}</td>
      <td>{{this.city}}</td>
      <td>{{this.telephone}}</td>
      <td>
        {{#each this.pets}}{{this.name}} {{/each}}
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>

{{#if (gt totalPages 1)}}
<div>
  <span>Pages:</span>
  <span>[</span>
  {{#each (range 1 totalPages)}}
    <a href="/owners?page={{this}}&lastName={{../query}}">{{this}}</a>
  {{/each}}
  <span>]</span>
</div>
{{/if}}
