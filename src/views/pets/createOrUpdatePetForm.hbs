<h2>{{#if pet.new}}New{{else}}Update{{/if}} Pet</h2>
<form class="form-horizontal" method="post">
  <div class="form-group mb-3">
    <label class="col-sm-2 control-label">Owner</label>
    <div class="col-sm-10">
      <span class="form-control-plaintext">{{owner.firstName}} {{owner.lastName}}</span>
    </div>
  </div>
  
  <div class="form-group has-feedback mb-3">
    <label class="col-sm-2 control-label">Name</label>
    <div class="col-sm-10">
      <input class="form-control {{#if errors.name}}is-invalid{{/if}}" name="name" value="{{pet.name}}" />
      {{#if errors.name}}<span class="invalid-feedback">{{errors.name.msg}}</span>{{/if}}
    </div>
  </div>

  <div class="form-group has-feedback mb-3">
    <label class="col-sm-2 control-label">Birth Date</label>
    <div class="col-sm-10">
      <input type="date" class="form-control {{#if errors.birthDate}}is-invalid{{/if}}" name="birthDate" value="{{pet.birthDate}}" />
      {{#if errors.birthDate}}<span class="invalid-feedback">{{errors.birthDate.msg}}</span>{{/if}}
    </div>
  </div>

  <div class="form-group has-feedback mb-3">
    <label class="col-sm-2 control-label">Type</label>
    <div class="col-sm-10">
      <select class="form-select {{#if errors.type}}is-invalid{{/if}}" name="type">
        {{#each types}}
          <option value="{{this}}" {{#if_eq this ../pet.type}}selected{{/if_eq}}>{{this}}</option>
        {{/each}}
      </select>
      {{#if errors.type}}<span class="invalid-feedback">{{errors.type.msg}}</span>{{/if}}
    </div>
  </div>

  <div class="form-group">
    <div class="col-sm-offset-2 col-sm-10">
      <button class="btn btn-primary" type="submit">{{#if pet.new}}Add{{else}}Update{{/if}} Pet</button>
    </div>
  </div>
</form>
