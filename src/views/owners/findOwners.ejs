<%- include('../fragments/layout', { template: 'find_owners_content', menu: 'owners' }) %>

<% function find_owners_content() { %>
  <h2><%= i18n.__('findOwners') %></h2>

  <form action="/owners" method="get" class="form-horizontal" id="search-owner-form">
    <div class="form-group">
      <div class="control-group" id="lastNameGroup">
        <label class="col-sm-2 control-label"><%= i18n.__('lastName') %></label>
        <div class="col-sm-10">
          <input class="form-control" type="text" name="lastName" value="<%= owner.lastName || '' %>" size="30" maxlength="80" />
          <% if (locals.error && locals.error.length > 0) { %>
            <span class="help-inline">
              <p><%= locals.error.join(', ') %></p>
            </span>
          <% } %>
        </div>
      </div>
    </div>
    <div class="form-group">
      <div class="col-sm-offset-2 col-sm-10">
        <button type="submit" class="btn btn-primary"><%= i18n.__('findOwner') %></button>
      </div>
    </div>

    <a class="btn btn-primary" href="/owners/new"><%= i18n.__('addOwner') %></a>

  </form>
<% } %>
