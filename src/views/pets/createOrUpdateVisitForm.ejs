<!DOCTYPE html>

<html lang="en">
<%- include('../fragments/layout', { template: 'pets/createOrUpdateVisitForm', menu: 'owners', i18n: i18n, t: t, owner: owner, pet: pet, visit: visit, validationErrors: errors }) %>

<body>

  <h2 class="mt-4">
    <% if (visit.isNew()) { %>
      <%= t('new') %>
    <% } %>
    <%= t('addVisit') %>
  </h2>

  <h3><%= t('pet') %></h3>
  <table class="table table-striped mt-3">
    <thead>
      <tr>
        <th><%= t('name') %></th>
        <th><%= t('birthDate') %></th>
        <th><%= t('type') %></th>
        <th><%= t('owner') %></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><%= pet.name %></td>
        <td><%= pet.birthDate ? new Date(pet.birthDate).toISOString().substring(0, 10) : '' %></td>
        <td><%= pet.type ? pet.type.name : '' %></td>
        <td><%= owner.firstName %> <%= owner.lastName %></td>
      </tr>
    </tbody>
  </table>

  <% if (error) { %>
    <div class="alert alert-danger" id="error-message">
      <span class="fa fa-remove" aria-hidden="true"></span>
      <span class="help-inline"><%= error %></span>
    </div>
  <% } %>

  <form action="/owners/<%= owner.id %>/pets/<%= pet.id %>/visits/new" method="post" class="form-horizontal">
    <div class="form-group has-feedback">
      <%- include('../fragments/inputField', { label: t('date'), name: 'date', type: 'date', value: visit.date, errors: errors, t: t }) %>
      <%- include('../fragments/inputField', { label: t('description'), name: 'description', type: 'text', value: visit.description, errors: errors, t: t }) %>
    </div>

    <div class="form-group mt-3">
      <div class="col-sm-offset-2 col-sm-10">
        <input type="hidden" name="petId" value="<%= pet.id %>" />
        <button class="btn btn-primary" type="submit"><%= t('addVisit') %></button>
      </div>
    </div>
  </form>

  <br />
  <h3 class="mt-4"><%= t('previousVisits') %></h3>
  <table class="table table-striped mt-3">
    <thead>
      <tr>
        <th><%= t('date') %></th>
        <th><%= t('description') %></th>
      </tr>
    </thead>
    <tbody>
      <% if (pet.visits && pet.visits.length > 0) { %>
        <% pet.visits.forEach(function(prevVisit) { %>
          <% if (prevVisit.id !== visit.id) { %>
            <tr>
              <td><%= prevVisit.date ? new Date(prevVisit.date).toISOString().substring(0, 10) : '' %></td>
              <td><%= prevVisit.description %></td>
            </tr>
          <% } %>
        <% }); %>
      <% } else { %>
        <tr>
          <td colspan="2">No previous visits.</td>
        </tr>
      <% } %>
    </tbody>
  </table>

</body>

</html>
