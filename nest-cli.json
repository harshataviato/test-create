{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "**/*.ejs",
      "**/*.json",
      "**/*.properties",
      "**/*.css",
      "**/*.eot",
      "**/*.ttf",
      "**/*.woff",
      "**/*.svg",
      "**/*.png"
    ],
    "watchAssets": true
  }
}
