<%- include('fragments/layout', { template: 'errorBody', menu: 'error', i18n: i18n, req: req }) %>

<%~ contentFor('errorBody') %>
  <img src="/resources/images/pets.png" alt="Pets image" />
  <!-- Title: Something happened -->
  <h2><%= i18n.t('messages.somethingHappened', { lang: req.i18nLang }) %></h2>

  <!-- Status-specific error message -->
  <p>
    <% if (status === 404) { %>
      <%= i18n.t('messages.error.404', { lang: req.i18nLang }) %>
    <% } else if (status === 500) { %>
      <%= i18n.t('messages.error.500', { lang: req.i18nLang }) %>
    <% } else { %>
      <%= i18n.t('messages.error.general', { lang: req.i18nLang }) %>
    <% } %>
  </p>

  <!-- Exception message (for developers) -->
  <p><%= message %></p>
