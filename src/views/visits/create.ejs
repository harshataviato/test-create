<%- include('../layout', { body: `
    <h2>New Visit</h2>
    <h4>Pet: ${pet.name}</h4>

    ${locals.errors ? errors.map(e => `<div class="alert alert-danger">${e.msg}</div>`).join('') : ''}

    <form method="post">
        <div class="mb-3">
            <label>Date</label>
            <input type="date" name="date" class="form-control" value="${visit.date || ''}" />
        </div>
        <div class="mb-3">
            <label>Description</label>
            <input name="description" class="form-control" value="${visit.description || ''}" />
        </div>
        <button type="submit" class="btn btn-primary">Add Visit</button>
    </form>
` }) %>
