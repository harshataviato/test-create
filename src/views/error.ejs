<%- include('fragments/layout', { template: 'error_content', menu: 'error' }) %>

<% function error_content() { %>
  <img src="/resources/images/pets.png" alt="Pets" />
  <!-- Title: Something happened -->
  <h2><%= i18n.__('somethingHappened') %></h2>

  <!-- Status-specific error message -->
  <p>
    <% if (status == 404) { %>
      <span><%= i18n.__('error.404') %></span>
    <% } else if (status == 500) { %>
      <span><%= i18n.__('error.500') %></span>
    <% } else { %>
      <span><%= i18n.__('error.general') %></span>
    <% } %>
  </p>

  <!-- Exception message (for developers) -->
  <p><%= message %></p>

  <% if (process.env.NODE_ENV === 'development' && stack) { %>
    <h3>Stack Trace:</h3>
    <pre><%= stack %></pre>
  <% } %>
<% } %>
