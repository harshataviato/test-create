<%- include('../layout/header') %>

<h2>Owner</h2>
<form class="form-horizontal" method="post">
    <!-- _method override handled by query param for true PUT, but standard POST works for this simple implementation or middleware -->
    
    <% const fields = [
        { name: 'firstName', label: 'First Name' },
        { name: 'lastName', label: 'Last Name' },
        { name: 'address', label: 'Address' },
        { name: 'city', label: 'City' },
        { name: 'telephone', label: 'Telephone' }
    ]; %>

    <% fields.forEach(function(field) { %>
        <div class="form-group row mb-3 <%= (locals.errors && errors[field.name]) ? 'has-error' : '' %>">
            <label class="col-sm-2 col-form-label"><%= field.label %></label>
            <div class="col-sm-10">
                <input class="form-control" type="text" name="<%= field.name %>" value="<%= owner[field.name] || '' %>" />
                <% if (locals.errors && errors[field.name]) { %>
                    <span class="text-danger"><%= errors[field.name] %></span>
                <% } %>
            </div>
        </div>
    <% }); %>

    <div class="form-group row mb-3">
        <div class="col-sm-offset-2 col-sm-10">
            <button class="btn btn-primary" type="submit"><%= owner.id ? 'Update Owner' : 'Add Owner' %></button>
        </div>
    </div>
</form>

<%- include('../layout/footer') %>
