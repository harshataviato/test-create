<!DOCTYPE html>
<html lang="<%= __locales.find(loc => loc.lang === __locale)?.lang || __locale %>">
<head>
  <%- include('../fragments/head', { title: __('layoutTitle'), menu: 'vets' }) %>
</head>
<body>
  <%- include('../fragments/header', { menu: 'vets' }) %>

  <div class="container-fluid">
    <div class="container xd-container">
      <h2 class="mt-4"><%= __('vets') %></h2>

      <table id="vets" class="table table-striped">
        <thead>
          <tr>
            <th><%= __('name') %></th>
            <th><%= __('specialties') %></th>
          </tr>
        </thead>
        <tbody>
          <% listVets.forEach(vet => { %>
            <tr>
              <td><%= vet.firstName + ' ' + vet.lastName %></td>
              <td>
                <% if (vet.getNrOfSpecialties() > 0) { %>
                  <%= vet.getSpecialties().map(specialty => specialty.name).join(', ') %>
                <% } else { %>
                  <%= __('none') %>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>

      <% if (totalPages > 1) { %>
        <div class="pagination-controls">
          <span><%= __('pages') %>:</span>
          <span>[</span>
          <% for (let i = 1; i <= totalPages; i++) { %>
            <% if (currentPage !== i) { %>
              <a href="/vets.html?page=<%= i %>"><%= i %></a>
            <% } else { %>
              <span><%= i %></span>
            <% } %>
          <% } %>
          <span>]&nbsp;</span>
          <span>
            <% if (currentPage > 1) { %>
              <a href="/vets.html?page=1" title="<%= __('first') %>" class="fa fa-fast-backward"></a>
            <% } else { %>
              <span class="fa fa-fast-backward disabled-link"></span>
            <% } %>
          </span>
          <span>
            <% if (currentPage > 1) { %>
              <a href="/vets.html?page=<%= currentPage - 1 %>" title="<%= __('previous') %>" class="fa fa-step-backward"></a>
            <% } else { %>
              <span class="fa fa-step-backward disabled-link"></span>
            <% } %>
          </span>
          <span>
            <% if (currentPage < totalPages) { %>
              <a href="/vets.html?page=<%= currentPage + 1 %>" title="<%= __('next') %>" class="fa fa-step-forward"></a>
            <% } else { %>
              <span class="fa fa-step-forward disabled-link"></span>
            <% } %>
          </span>
          <span>
            <% if (currentPage < totalPages) { %>
              <a href="/vets.html?page=<%= totalPages %>" title="<%= __('last') %>" class="fa fa-fast-forward"></a>
            <% } else { %>
              <span class="fa fa-fast-forward disabled-link"></span>
            <% } %>
          </span>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('../fragments/footer') %>
</body>
</html>

