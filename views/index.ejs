<!-- 
  Module: Task List View
  Description: Renders a list of all tasks. 
  Expects parameter: `tasks` (Array of Task objects).
-->
<%- include('layout', { body: `
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Your Tasks</h2>
        <a href="/new" class="btn btn-primary">+ Create New Task</a>
    </div>

    ${tasks.length === 0 ? `
        <div class="alert alert-info text-center">
            No tasks found. Create one to get started!
        </div>
    ` : `
        <div class="list-group">
            ${tasks.map(task => `
                <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center card">
                    <div>
                        <h5 class="mb-1 ${task.isCompleted ? 'completed' : ''}">${task.title}</h5>
                        <p class="mb-1 text-muted small">${task.description || 'No description provided.'}</p>
                        <small class="text-secondary">Created: ${new Date(task.createdAt).toLocaleDateString()}</small>
                    </div>
                    <div class="btn-group">
                        <a href="/edit/${task.id}" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form action="/delete/${task.id}" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this task?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </div>
            `).join('')}
        </div>
    `}
` }) %>
