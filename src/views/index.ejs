<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body {
            font-family: 'Roboto', Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #f8f9fa;
        }
        .container {
            text-align: center;
            padding: 2rem;
            background: white;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        h1 { color: #4285f4; }
        p { color: #5f6368; }
    </style>
</head>
<body>
    <div class="container">
        <!-- Renders the greeting provided by the Controller -->
        <h1><%= greeting %></h1>
        <p>Server-side rendered at: <%= time %></p>
    </div>
</body>
</html>
