<h2>Owners</h2>

<table id="owners" class="table table-striped">
    <thead>
        <tr>
            <th style="width: 150px;">Name</th>
            <th style="width: 200px;">Address</th>
            <th>City</th>
            <th style="width: 120px">Telephone</th>
            <th>Pets</th>
        </tr>
    </thead>
    <tbody>
        <% listOwners.forEach(function(owner) { %>
        <tr>
            <td>
                <a href="/owners/<%= owner.id %>"><%= owner.firstName %> <%= owner.lastName %></a>
            </td>
            <td><%= owner.address %></td>
            <td><%= owner.city %></td>
            <td><%= owner.telephone %></td>
            <td>
                <% 
                   let petNames = owner.pets.map(p => p.name).join(', ');
                %>
                <%= petNames %>
            </td>
        </tr>
        <% }); %>
    </tbody>
</table>

<% if (totalPages > 1) { %>
    <div>
        <span>Pages:</span>
        <span>[</span>
        <% for(let i = 1; i <= totalPages; i++) { %>
            <% if (currentPage != i) { %>
                <a href="/owners?page=<%= i %>"><%= i %></a>
            <% } else { %>
                <span><%= i %></span>
            <% } %>
        <% } %>
        <span>]</span>
    </div>
<% } %>
