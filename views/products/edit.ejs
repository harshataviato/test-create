<!-- Extends the base layout for common header, footer, etc. -->
<%- layout('layout') %>

<!-- Main content for the product edit form -->
<div class="container form-container">
  <h2><%= title %></h2>

  <!-- Error message display for form-specific errors -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert error">
      <p><strong>Validation Error:</strong> <%= error %></p>
    </div>
  <% } %>

  <!-- Form to edit an existing product -->
  <!-- The action points to /products/:id. `_method=PUT` is used with `method-override` to simulate a PUT request. -->
  <form action="/products/<%= product._id %>?_method=PUT" method="POST">
    <div class="form-group">
      <label for="name">Product Name:</label>
      <!-- Input field pre-filled with the current product name -->
      <input type="text" id="name" name="name" value="<%= product.name %>" required>
    </div>

    <div class="form-group">
      <label for="description">Description:</label>
      <!-- Textarea pre-filled with the current product description -->
      <textarea id="description" name="description" rows="5"><%= product.description %></textarea>
    </div>

    <div class="form-group">
      <label for="price">Price:</label>
      <!-- Input field pre-filled with the current product price -->
      <input type="number" id="price" name="price" value="<%= product.price %>" step="0.01" min="0" required>
    </div>

    <div class="form-group">
      <label for="quantity">Quantity:</label>
      <!-- Input field pre-filled with the current product quantity -->
      <input type="number" id="quantity" name="quantity" value="<%= product.quantity %>" min="0" required>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Update Product</button>
      <a href="/products/<%= product._id %>" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
