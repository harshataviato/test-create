<!DOCTYPE html>
<html lang="<%= __locales[__locale].lang %>">
<head>
  <%- include('../fragments/head', { title: __('layoutTitle'), menu: 'owners' }) %>
</head>
<body>
  <%- include('../fragments/header', { menu: 'owners' }) %>

  <div class="container-fluid">
    <div class="container xd-container">
      <h2 class="mt-4"><%= __('owners') %></h2>

      <table id="owners" class="table table-striped">
        <thead>
          <tr>
            <th style="width: 150px;"><%= __('name') %></th>
            <th style="width: 200px;"><%= __('address') %></th>
            <th><%= __('city') %></th>
            <th style="width: 120px"><%= __('telephone') %></th>
            <th><%= __('pets') %></th>
          </tr>
        </thead>
        <tbody>
          <% listOwners.forEach(owner => { %>
            <tr>
              <td>
                <a href="/owners/<%= owner.id %>"><%= owner.firstName + ' ' + owner.lastName %></a>
              </td>
              <td><%= owner.address %></td>
              <td><%= owner.city %></td>
              <td><%= owner.telephone %></td>
              <td>
                <%= owner.getPets().map(pet => pet.name).join(', ') %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>

      <% if (totalPages > 1) { %>
        <div class="pagination-controls">
          <span><%= __('pages') %>:</span>
          <span>[</span>
          <% for (let i = 1; i <= totalPages; i++) { %>
            <% if (currentPage !== i) { %>
              <a href="/owners?page=<%= i %>"><%= i %></a>
            <% } else { %>
              <span><%= i %></span>
            <% } %>
          <% } %>
          <span>]&nbsp;</span>
          <span>
            <% if (currentPage > 1) { %>
              <a href="/owners?page=1" title="<%= __('first') %>" class="fa fa-fast-backward"></a>
            <% } else { %>
              <span class="fa fa-fast-backward disabled-link"></span>
            <% } %>
          </span>
          <span>
            <% if (currentPage > 1) { %>
              <a href="/owners?page=<%= currentPage - 1 %>" title="<%= __('previous') %>" class="fa fa-step-backward"></a>
            <% } else { %>
              <span class="fa fa-step-backward disabled-link"></span>
            <% } %>
          </span>
          <span>
            <% if (currentPage < totalPages) { %>
              <a href="/owners?page=<%= currentPage + 1 %>" title="<%= __('next') %>" class="fa fa-step-forward"></a>
            <% } else { %>
              <span class="fa fa-step-forward disabled-link"></span>
            <% } %>
          </span>
          <span>
            <% if (currentPage < totalPages) { %>
              <a href="/owners?page=<%= totalPages %>" title="<%= __('last') %>" class="fa fa-fast-forward"></a>
            <% } else { %>
              <span class="fa fa-fast-forward disabled-link"></span>
            <% } %>
          </span>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('../fragments/footer') %>
</body>
</html>
