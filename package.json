{
  "name": "petclinic-node",
  "version": "1.0.0",
  "description": "Node.js (TypeScript) port of Spring PetClinic application",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "typeorm": "typeorm-ts-node-commonjs -d ./src/database/data-source.ts",
    "seed": "ts-node src/database/seed/initialData.ts",
    "test": "jest"
  },
  "keywords": [],
