<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../fragments/layout', { template: 'pets/createOrUpdatePetForm', menu: 'owners', __: __, temporals: temporals, strings: strings }) %>
</head>
<body>
  <%- include('../fragments/layout', { template: 'pets/createOrUpdatePetForm', menu: 'owners', __: __, temporals: temporals, strings: strings }, function() { %>
    <h2>
      <% if (pet.isNew()) { %>
        <%= __("new") %>
      <% } %>
      <%= __("pet") %>
    </h2>
    <form action="/owners/<%= owner.id %>/pets/<%= pet.id ? pet.id + '/edit' : 'new' %>" method="post" class="form-horizontal">
      <% if (locals.errors) { %>
        <div class="alert alert-danger" id="error-message">
          <span><%= locals.errors %></span>
        </div>
      <% } %>

      <input type="hidden" name="id" value="<%= pet.id || '' %>" />
      <div class="form-group has-feedback">
        <div class="form-group">
          <label class="col-sm-2 control-label"><%= __("owner") %></label>
          <div class="col-sm-10">
            <span><%= owner.firstName + ' ' + owner.lastName %></span>
          </div>
        </div>
        <%- include('../fragments/inputField', { label: __("name"), name: 'name', type: 'text', value: pet.name, errors: locals.errors }) %>
        <%- include('../fragments/inputField', { label: __("birthDate"), name: 'birthDate', type: 'date', value: pet.birthDate, errors: locals.errors }) %>
        <%- include('../fragments/selectField', { label: __("type"), name: 'type', items: types, value: pet.type, errors: locals.errors }) %>
      </div>
      <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10">
          <button class="btn btn-primary" type="submit">
            <%= pet.isNew() ? __("addPet") : __("updatePet") %>
          </button>
        </div>
      </div>
    </form>
  <% }) %>
</body>
</html>
