<h2>Owner</h2>
<form class="form-horizontal" id="add-owner-form" method="post">
    <!-- First Name -->
    <div class="form-group mb-3 <%= locals.errors && errors.firstName ? 'has-error' : '' %>">
        <label class="col-sm-2 control-label">First Name</label>
        <div class="col-sm-10">
            <input class="form-control" type="text" name="firstName" value="<%= owner.firstName || '' %>" />
            <% if (locals.errors && errors.firstName) { %>
                <span class="help-inline text-danger"><%= errors.firstName.msg %></span>
            <% } %>
        </div>
    </div>

    <!-- Last Name -->
    <div class="form-group mb-3 <%= locals.errors && errors.lastName ? 'has-error' : '' %>">
        <label class="col-sm-2 control-label">Last Name</label>
        <div class="col-sm-10">
            <input class="form-control" type="text" name="lastName" value="<%= owner.lastName || '' %>" />
            <% if (locals.errors && errors.lastName) { %>
                <span class="help-inline text-danger"><%= errors.lastName.msg %></span>
            <% } %>
        </div>
    </div>

    <!-- Address -->
    <div class="form-group mb-3 <%= locals.errors && errors.address ? 'has-error' : '' %>">
        <label class="col-sm-2 control-label">Address</label>
        <div class="col-sm-10">
            <input class="form-control" type="text" name="address" value="<%= owner.address || '' %>" />
            <% if (locals.errors && errors.address) { %>
                <span class="help-inline text-danger"><%= errors.address.msg %></span>
            <% } %>
        </div>
    </div>

    <!-- City -->
    <div class="form-group mb-3 <%= locals.errors && errors.city ? 'has-error' : '' %>">
        <label class="col-sm-2 control-label">City</label>
        <div class="col-sm-10">
            <input class="form-control" type="text" name="city" value="<%= owner.city || '' %>" />
            <% if (locals.errors && errors.city) { %>
                <span class="help-inline text-danger"><%= errors.city.msg %></span>
            <% } %>
        </div>
    </div>

    <!-- Telephone -->
    <div class="form-group mb-3 <%= locals.errors && errors.telephone ? 'has-error' : '' %>">
        <label class="col-sm-2 control-label">Telephone</label>
        <div class="col-sm-10">
            <input class="form-control" type="text" name="telephone" value="<%= owner.telephone || '' %>" />
            <% if (locals.errors && errors.telephone) { %>
                <span class="help-inline text-danger"><%= errors.telephone.msg %></span>
            <% } %>
        </div>
    </div>

    <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10">
            <button class="btn btn-primary" type="submit">
                <%= mode === 'create' ? 'Add Owner' : 'Update Owner' %>
            </button>
        </div>
    </div>
</form>
