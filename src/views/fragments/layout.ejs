<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PetClinic :: a Node.js demonstration</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="/resources/css/petclinic.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark" role="navigation">
    <div class="container-fluid">
        <a class="navbar-brand" href="/"><span></span></a>
        <div class="collapse navbar-collapse" id="main-navbar">
            <ul class="nav navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link <%= menu === 'home' ? 'active' : '' %>" href="/">
                        <span class="fa fa-home"></span> <%= __('home') %>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= menu === 'owners' ? 'active' : '' %>" href="/owners/find">
                        <span class="fa fa-search"></span> <%= __('findOwners') %>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= menu === 'vets' ? 'active' : '' %>" href="/vets">
                        <span class="fa fa-th-list"></span> <%= __('vets') %>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/oups">
                        <span class="fa fa-exclamation-triangle"></span> <%= __('error') %>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container-fluid">
    <div class="container xd-container">
        <%- body %>
        
        <br/><br/>
        <div class="container">
            <div class="row">
                <div class="col-12 text-center">
                    <img src="/resources/images/spring-logo.svg" alt="Logo" class="logo">
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>
