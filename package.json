{
  "name": "node-petclinic",
  "version": "1.0.0",
  "description": "Pragmatic port of Spring PetClinic to Node.js",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "reset-db": "node seed/init.js",
