<!DOCTYPE html>
<html lang="<%= req.i18nLang %>">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="shortcut icon" type="image/x-icon" href="/resources/images/favicon.png">
  <title><%= i18n.t('messages.layoutTitle', { lang: req.i18nLang }) %></title>
  <link href="/webjars/font-awesome/css/font-awesome.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/resources/css/petclinic.css" />
</head>
<body>

  <nav class="navbar navbar-expand-lg navbar-dark" role="navigation">
    <div class="container-fluid">
      <a class="navbar-brand" href="/"><span></span></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navbar" aria-controls="main-navbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="main-navbar">
        <ul class="nav navbar-nav me-auto">
          <li class="nav-item">
            <a class="nav-link <%= menu === 'home' ? 'active' : '' %>" href="/" title="<%= i18n.t('messages.home', { lang: req.i18nLang }) %>">
              <span class="fa fa-home"></span>
              <span th:text="#{home}"><%= i18n.t('messages.home', { lang: req.i18nLang }) %></span>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= menu === 'owners' ? 'active' : '' %>" href="/owners/find" title="<%= i18n.t('messages.findOwners', { lang: req.i18nLang }) %>">
              <span class="fa fa-search"></span>
              <span th:text="#{findOwners}"><%= i18n.t('messages.findOwners', { lang: req.i18nLang }) %></span>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= menu === 'vets' ? 'active' : '' %>" href="/vets.html" title="<%= i18n.t('messages.vets', { lang: req.i18nLang }) %>">
              <span class="fa fa-th-list"></span>
              <span th:text="#{vets}"><%= i18n.t('messages.vets', { lang: req.i18nLang }) %></span>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= menu === 'error' ? 'active' : '' %>" href="/oups" title="<%= i18n.t('messages.error', { lang: req.i18nLang }) %>">
              <span class="fa fa-exclamation-triangle"></span>
              <span th:text="#{error}"><%= i18n.t('messages.error', { lang: req.i18nLang }) %></span>
            </a>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <%= req.i18nLang.toUpperCase() %>
            </a>
            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
              <li><a class="dropdown-item" href="?lang=en">English</a></li>
              <li><a class="dropdown-item" href="?lang=de">Deutsch</a></li>
              <li><a class="dropdown-item" href="?lang=es">Español</a></li>
              <li><a class="dropdown-item" href="?lang=fa">فارسی</a></li>
              <li><a class="dropdown-item" href="?lang=ko">한국어</a></li>
              <li><a class="dropdown-item" href="?lang=pt">Português</a></li>
              <li><a class="dropdown-item" href="?lang=ru">Русский</a></li>
              <li><a class="dropdown-item" href="?lang=tr">Türkçe</a></li>
            </ul>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container-fluid">
    <div class="container xd-container">
      <%~ include(template, { ...locals }) %>
      <br />
      <br />
      <div class="container">
        <div class="row">
          <div class="col-12 text-center">
            <img src="/resources/images/spring-logo.svg" alt="VMware Tanzu Logo" class="logo">
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/webjars/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
