  "license": "Apache-2.0",
  "dependencies": {
    "body-parser": "^1.20.2",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-handlebars": "^7.1.2",
    "express-session": "^1.18.0",
    "i18n": "^0.15.1",
    "moment": "^2.30.1",
    "node-cache": "^5.1.2",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/connect-flash": "^0.0.10",
    "@types/express": "^4.17.21",
    "@types/express-handlebars": "^6.0.0",
    "@types/express-session": "^1.18.0",
    "@types/i18n": "^0.13.11",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/node-cache": "^4.2.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
