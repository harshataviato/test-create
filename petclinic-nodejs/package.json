{
  "name": "petclinic-nodejs",
  "version": "1.0.0",
  "description": "PetClinic Sample Application in Node.js",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "npx sequelize db:migrate",
    "db:seed": "npx sequelize db:seed:all",
    "db:reset": "npx sequelize db:migrate:undo:all && npx sequelize db:migrate && npx sequelize db:seed:all"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ejs": "^3.1.9",
    "sequelize": "^6.35.2",
    "sqlite3": "^5.1.7",
    "dotenv": "^16.3.1",
    "i18n": "^0.15.1",
    "express-validator": "^7.0.1",
    "mysql2": "^3.6.5",
    "pg": "^8.11.3",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.2"
  }
}
