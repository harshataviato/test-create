<%- include('../fragments/layout', { template: 'pet_form_content', menu: 'owners' }) %>

<% function pet_form_content() { %>
  <h2>
    <% if (pet.isNew()) { %>
      <%= i18n.__('new') %>
    <% } %>
    <%= i18n.__('pet') %>
  </h2>

  <form action="/owners/<%= owner.id %>/pets<%= pet.isNew() ? '/new' : '/' + pet.id + '/edit' %>" class="form-horizontal" method="post">
    <% if (!pet.isNew()) { %>
      <input type="hidden" name="id" value="<%= pet.id %>" />
    <% } %>
    <div class="form-group has-feedback">
      <div class="form-group">
        <label class="col-sm-2 control-label"><%= i18n.__('owner') %></label>
        <div class="col-sm-10">
          <span><%= owner.firstName + ' ' + owner.lastName %></span>
        </div>
      </div>
      <%- include('../fragments/inputField', { label: 'name', name: 'name', type: 'text', model: pet, errors: errors, i18n: i18n }) %>
      <%- include('../fragments/inputField', { label: 'birthDate', name: 'birthDate', type: 'date', model: pet, errors: errors, i18n: i18n }) %>
      <%- include('../fragments/selectField', { label: 'type', name: 'type', items: types, model: pet, errors: errors, i18n: i18n }) %>
    </div>
    <div class="form-group">
      <div class="col-sm-offset-2 col-sm-10">
        <button class="btn btn-primary" type="submit">
          <%= pet.isNew() ? i18n.__('addPet') : i18n.__('updatePet') %>
        </button>
      </div>
    </div>
  </form>
<% } %>
