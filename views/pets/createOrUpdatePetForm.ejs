<!DOCTYPE html>
<html>
<%- include('../partials/header') %>
<body>
  <%- include('../partials/navbar') %>
  <div class="container xd-container">
    <h2><%= pet.id ? 'Update' : 'New' %> Pet</h2>
    
    <form class="form-horizontal" method="post">
      <div class="form-group mb-3">
        <label class="col-sm-2 control-label">Owner</label>
        <div class="col-sm-10">
          <span><%= owner.firstName %> <%= owner.lastName %></span>
        </div>
      </div>

      <div class="form-group mb-3 <%= (locals.errors && errors.name) ? 'has-error' : '' %>">
        <label class="col-sm-2 control-label">Name</label>
        <div class="col-sm-10">
          <input class="form-control" type="text" name="name" value="<%= pet.name || '' %>" />
          <% if (locals.errors && errors.name) { %><span class="text-danger"><%= errors.name.msg %></span><% } %>
        </div>
      </div>

      <div class="form-group mb-3 <%= (locals.errors && errors.birthDate) ? 'has-error' : '' %>">
        <label class="col-sm-2 control-label">Birth Date</label>
        <div class="col-sm-10">
          <input class="form-control" type="date" name="birthDate" value="<%= pet.birthDate ? moment(pet.birthDate).format('YYYY-MM-DD') : '' %>" />
          <% if (locals.errors && errors.birthDate) { %><span class="text-danger"><%= errors.birthDate.msg %></span><% } %>
        </div>
      </div>

      <div class="form-group mb-3 <%= (locals.errors && errors.typeId) ? 'has-error' : '' %>">
        <label class="col-sm-2 control-label">Type</label>
        <div class="col-sm-10">
          <select class="form-control" name="typeId">
            <% types.forEach(function(type) { %>
              <option value="<%= type.id %>" <%= (pet.typeId == type.id) ? 'selected' : '' %>><%= type.name %></option>
            <% }); %>
          </select>
          <% if (locals.errors && errors.typeId) { %><span class="text-danger"><%= errors.typeId.msg %></span><% } %>
        </div>
      </div>

      <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10">
          <button class="btn btn-primary" type="submit"><%= pet.id ? 'Update Pet' : 'Add Pet' %></button>
        </div>
      </div>
    </form>
  </div>
</body>
</html>
