{{!< layouts/main}}

<h2>{{ownerTitle}}</h2>
<form action="/owners/{{#if owner.id}}{{owner.id}}/edit{{else}}new{{/if}}" method="post" class="form-horizontal" id="add-owner-form">
  {{#if owner.id}}
    <input type="hidden" name="id" value="{{owner.id}}" />
  {{/if}}
  <div class="form-group has-feedback">
    {{> partials/inputField label="firstName" name="firstName" type="text" defaultValue=owner.firstName errors=errors}}
    {{> partials/inputField label="lastName" name="lastName" type="text" defaultValue=owner.lastName errors=errors}}
    {{> partials/inputField label="address" name="address" type="text" defaultValue=owner.address errors=errors}}
    {{> partials/inputField label="city" name="city" type="text" defaultValue=owner.city errors=errors}}
    {{> partials/inputField label="telephone" name="telephone" type="text" defaultValue=owner.telephone errors=errors}}
  </div>
  <div class="form-group">
    <div class="col-sm-offset-2 col-sm-10">
      <button class="btn btn-primary" type="submit">{{#if owner.id}}{{i18n updateOwner}}{{else}}{{i18n addOwner}}{{/if}}</button>
    </div>
  </div>
</form>
