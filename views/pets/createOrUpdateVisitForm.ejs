<%- include('../common/header', { title: title, activePage: 'owners' }) %>

<div class="container my-4">
    <h2 class="mb-4"><%= title %></h2>

    <div class="mb-3">
        <label for="petName" class="form-label">Pet</label>
        <input type="text" class="form-control" id="petName" value="<%= pet.name %>" readonly>
    </div>
    <div class="mb-3">
        <label for="petBirthDate" class="form-label"><%= __('common.birthDate') %></label>
        <input type="text" class="form-control" id="petBirthDate" value="<%= moment(pet.birthDate).format('YYYY/MM/DD') %>" readonly>
    </div>
    <div class="mb-3">
        <label for="petType" class="form-label"><%= __('common.type') %></label>
        <input type="text" class="form-control" id="petType" value="<%= pet.type ? pet.type.name : 'Unknown' %>" readonly>
    </div>

    <h4 class="mt-4"><%= __('visit.newVisitTitle', { petName: pet.name }) %></h4>
    <form action="/owners/<%= owner.id %>/pets/<%= pet.id %>/visits/new" method="post">
        <div class="form-group mb-3">
            <label for="visitDate" class="form-label"><%= __('common.visitDate') %></label>
            <input type="date" class="form-control <%= errors.visitDate ? 'is-invalid' : '' %>" id="visitDate" name="visitDate" value="<%= visit.visitDate || '' %>" required>
            <% if (errors.visitDate) { %><div class="invalid-feedback"><%= errors.visitDate.msg %></div><% } %>
        </div>

        <div class="form-group mb-3">
            <label for="description" class="form-label"><%= __('common.description') %></label>
            <textarea class="form-control <%= errors.description ? 'is-invalid' : '' %>" id="description" name="description" rows="3" required><%= visit.description || '' %></textarea>
            <% if (errors.description) { %><div class="invalid-feedback"><%= errors.description.msg %></div><% } %>
        </div>

        <div class="d-flex justify-content-start my-4">
            <button type="submit" class="btn btn-success me-2"><%= __('common.save') %></button>
            <a href="/owners/<%= owner.id %>" class="btn btn-secondary"><%= __('common.cancel') %></a>
        </div>
    </form>
</div>

<%- include('../common/footer') %>
