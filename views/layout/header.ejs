<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PetClinic :: a Node.js demonstration</title>
    <!-- Use CDN for Bootstrap as huge local files were removed for brevity, ensuring style matches -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/petclinic.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/"><span></span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="main-navbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/" title="home page">
                            <span class="fa fa-home"></span> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= currentPath.startsWith('/owners') ? 'active' : '' %>" href="/owners/find" title="find owners">
                            <span class="fa fa-search"></span> Find owners
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= currentPath.startsWith('/vets') ? 'active' : '' %>" href="/vets.html" title="veterinarians">
                            <span class="fa fa-th-list"></span> Veterinarians
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/oups" title="trigger error">
                            <span class="fa fa-exclamation-triangle"></span> Error
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container-fluid">
        <div class="container xd-container">
