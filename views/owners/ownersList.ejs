<% var activePage = 'owners'; %>
<% 
var content = `
    <h2>Owners</h2>

    <table id="owners" class="table table-striped">
        <thead>
            <tr>
                <th style="width: 150px;">Name</th>
                <th style="width: 200px;">Address</th>
                <th>City</th>
                <th style="width: 120px">Telephone</th>
                <th>Pets</th>
            </tr>
        </thead>
        <tbody>
            ${listOwners.map(owner => `
                <tr>
                    <td>
                        <a href="/owners/${owner.id}">${owner.firstName} ${owner.lastName}</a>
                    </td>
                    <td>${owner.address}</td>
                    <td>${owner.city}</td>
                    <td>${owner.telephone}</td>
                    <td>
                        ${owner.pets ? owner.pets.map(p => p.name).join(', ') : ''}
                    </td>
                </tr>
            `).join('')}
        </tbody>
    </table>
`;

// Pagination Logic
if (totalPages > 1) {
    content += '<div class="pagination-container"><span>Pages: [</span>';
    for (let i = 1; i <= totalPages; i++) {
        if(currentPage == i) {
            content += `<span>${i}</span>`;
        } else {
            content += `<a href="/owners?page=${i}">${i}</a>`;
        }
        if(i < totalPages) content += ' ';
    }
    content += ']</div>';
}

var body = content;
%>
<%- include('../layout', {body: body, activePage: activePage}) %>
