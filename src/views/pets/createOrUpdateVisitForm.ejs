<%- include('../fragments/layout', { template: 'visit_form_content', menu: 'owners' }) %>

<% function visit_form_content() { %>
  <h2>
    <% if (visit.isNew()) { %>
      <%= i18n.__('new') %>
    <% } %>
    Visit
  </h2>

  <b><%= i18n.__('pet') %></b>
  <table class="table table-striped">
    <thead>
      <tr>
        <th><%= i18n.__('name') %></th>
        <th><%= i18n.__('birthDate') %></th>
        <th><%= i18n.__('type') %></th>
        <th><%= i18n.__('owner') %></th>
      </tr>
    </thead>
    <tr>
      <td><%= pet.name %></td>
      <td><%= sequelize.ejs.moment(pet.birthDate).format('YYYY-MM-DD') %></td>
      <td><%= pet.type ? pet.type.name : '' %></td>
      <td><%= owner.firstName + ' ' + owner.lastName %></td>
    </tr>
  </table>

  <form action="/owners/<%= owner.id %>/pets/<%= pet.id %>/visits/new" class="form-horizontal" method="post">
    <div class="form-group has-feedback">
      <%- include('../fragments/inputField', { label: 'date', name: 'date', type: 'date', model: visit, errors: errors, i18n: i18n }) %>
      <%- include('../fragments/inputField', { label: 'description', name: 'description', type: 'text', model: visit, errors: errors, i18n: i18n }) %>
    </div>

    <div class="form-group">
      <div class="col-sm-offset-2 col-sm-10">
        <input type="hidden" name="petId" value="<%= pet.id %>" />
        <button class="btn btn-primary" type="submit"><%= i18n.__('addVisit') %></button>
      </div>
    </div>
  </form>

  <br />
  <b><%= i18n.__('previousVisits') %></b>
  <table class="table table-striped">
    <tr>
      <th><%= i18n.__('date') %></th>
      <th><%= i18n.__('description') %></th>
    </tr>
    <% if (pet.visits && pet.visits.length > 0) { %>
      <% pet.visits.forEach(prevVisit => { %>
        <tr>
          <td><%= sequelize.ejs.moment(prevVisit.visitDate).format('YYYY-MM-DD') %></td>
          <td><%= prevVisit.description %></td>
        </tr>
      <% }); %>
    <% } else { %>
      <tr>
        <td colspan="2"><%= i18n.__('none') %></td>
      </tr>
    <% } %>
  </table>
<% } %>
