<%- layout('layout') %>

<h2 class="mt-4"><%= title %></h2>

<table class="table table-striped" style="width: 600px;">
  <thead>
    <tr>
      <th colspan="2"><%= owner.firstName %> <%= owner.lastName %></th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><%= __('owner.address') %></td>
      <td><%= owner.address %></td>
    </tr>
    <tr>
      <td><%= __('owner.city') %></td>
      <td><%= owner.city %></td>
    </tr>
    <tr>
      <td><%= __('owner.telephone') %></td>
      <td><%= owner.telephone %></td>
    </tr>
  </tbody>
</table>

<a href="/owners/<%= owner.id %>/edit" class="btn btn-primary"><%= __('button.editOwner') %></a>
<a href="/owners/<%= owner.id %>/pets/new" class="btn btn-success ms-2"><%= __('button.addNewPet') %></a>

<h2 class="mt-5"><%= __('owner.pets') %></h2>

<% if (owner.pets && owner.pets.length > 0) { %>
  <% owner.pets.forEach(function(pet) { %>
    <table class="table table-striped" style="width: 600px;">
      <thead>
        <tr>
          <th colspan="2">
            <b><%= pet.name %></b>
            <a href="/owners/<%= owner.id %>/pets/<%= pet.id %>/edit" class="btn btn-sm btn-info ms-2"><%= __('button.editPet') %></a>
            <a href="/owners/<%= owner.id %>/pets/<%= pet.id %>/visits/new" class="btn btn-sm btn-success ms-2"><%= __('button.addVisit') %></a>
          </th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= __('pet.birthDate') %></td>
          <td><%= moment(pet.birthDate).format('YYYY-MM-DD') %></td>
        </tr>
        <tr>
          <td><%= __('pet.type') %></td>
          <td><%= pet.type ? pet.type.name : 'N/A' %></td>
        </tr>
        <% if (pet.visits && pet.visits.length > 0) { %>
          <tr>
            <td><%= __('pet.visits') %></td>
            <td>
              <table class="table table-sm table-bordered">
                <thead>
                  <tr>
                    <th><%= __('visit.date') %></th>
                    <th><%= __('visit.description') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% pet.visits.forEach(function(visit) { %>
                    <tr>
                      <td><%= moment(visit.date).format('YYYY-MM-DD') %></td>
                      <td><%= visit.description %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </td>
          </tr>
        <% } else { %>
          <tr>
            <td><%= __('pet.visits') %></td>
            <td><p><%= __('pet.noVisits') %></p></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  <% }); %>
<% } else { %>
  <p><%= __('owner.noPets') %></p>
<% } %>

