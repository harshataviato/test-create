# Application Port
PORT=8080

# Database Configuration
# Options: sqlite, mysql, postgres
DB_DIALECT=sqlite

# SQLite specific (if DB_DIALECT=sqlite)
SQLITE_STORAGE=./data/petclinic.sqlite

# MySQL specific (if DB_DIALECT=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=petclinic
MYSQL_PASSWORD=petclinic
MYSQL_DATABASE=petclinic

# PostgreSQL specific (if DB_DIALECT=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=petclinic
POSTGRES_PASSWORD=petclinic
POSTGRES_DATABASE=petclinic

# Caching
CACHE_TTL_SECONDS=3600 # Time to live for cached items (e.g., vets list)

# Internationalization
DEFAULT_LOCALE=en
