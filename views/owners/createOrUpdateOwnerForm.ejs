<!DOCTYPE html>
<html>
<%- include('../partials/header') %>
<body>
  <%- include('../partials/navbar') %>
  <div class="container xd-container">
    <h2>Owner</h2>
    <form class="form-horizontal" method="post">
      <!-- Reusable Input Helper -->
      <% 
        const renderInput = (label, name) => {
          const val = owner[name] || '';
          const err = (locals.errors && errors[name]) ? errors[name].msg : null;
          const classGroup = err ? 'form-group has-error' : 'form-group';
          return `
            <div class="${classGroup} mb-3">
              <label class="col-sm-2 control-label">${label}</label>
              <div class="col-sm-10">
                <input class="form-control" type="text" name="${name}" value="${val}" />
                ${err ? `<span class="help-inline text-danger">${err}</span>` : ''}
              </div>
            </div>
          `;
        }
      %>
      
      <%- renderInput('First Name', 'firstName') %>
      <%- renderInput('Last Name', 'lastName') %>
      <%- renderInput('Address', 'address') %>
      <%- renderInput('City', 'city') %>
      <%- renderInput('Telephone', 'telephone') %>

      <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10">
          <button class="btn btn-primary" type="submit">
            <%= owner.id ? 'Update Owner' : 'Add Owner' %>
          </button>
        </div>
      </div>
    </form>
  </div>
</body>
</html>
