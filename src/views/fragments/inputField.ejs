<%
// inputField.ejs: A reusable EJS fragment for rendering form input fields with validation feedback.
// This fragment simplifies form creation by providing a consistent structure for input elements.
// It supports different input types (text, date) and displays validation errors.
//
// Parameters:
//   label (string): The visible label for the input field.
//   name (string): The name attribute for the input field, also used for form binding.
//   type (string): The HTML input type (e.g., 'text', 'date').
//   value (any, optional): The initial value for the input field.
//   errors (array of strings, optional): An array of error messages associated with this field.
//   i18n (I18nService): The i18n service instance for translation.
//   req (Request): The request object containing language information.

// Determine if the field is valid (no errors).
const fieldName = name; // Name of the field for error lookup
const fieldErrors = errors && errors[fieldName] ? errors[fieldName] : [];
const isValid = fieldErrors.length === 0;
%>

<div class="form-group<%= isValid ? '' : ' has-error' %>">
  <label for="<%= name %>" class="col-sm-2 control-label"><%= i18n.t(`messages.${label}`, { lang: req.i18nLang }) %></label>
  <div class="col-sm-10">
    <% if (type === 'text') { %>
      <input class="form-control" type="text" id="<%= name %>" name="<%= name %>" value="<%= value || '' %>" />
    <% } else if (type === 'date') {
      // Format date to YYYY-MM-DD for HTML date input
      let formattedDate = '';
      if (value) {
        const d = new Date(value);
        formattedDate = d.toISOString().split('T')[0];
      }
    %>
      <input class="form-control" type="date" id="<%= name %>" name="<%= name %>" value="<%= formattedDate %>" />
    <% } %>
    <% if (isValid) { %>
      <span class="fa fa-ok form-control-feedback" aria-hidden="true"></span>
    <% } else { %>
      <span class="fa fa-remove form-control-feedback" aria-hidden="true"></span>
      <span class="help-inline"><%= fieldErrors.join(', ') %></span>
    <% } %>
  </div>
</div>
