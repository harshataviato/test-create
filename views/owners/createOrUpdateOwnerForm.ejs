<h2>Owner</h2>
<form class="form-horizontal" id="add-owner-form" method="post">
    <!-- Helper Mixin for Inputs -->
    <% function inputField(label, name, value, type='text') { 
        const error = errors && errors.find(e => e.path === name);
    %>
    <div class="form-group mb-3 <%= error ? 'has-error' : '' %>">
        <label class="col-sm-2 control-label"><%= label %></label>
        <div class="col-sm-10">
            <input class="form-control" type="<%= type %>" name="<%= name %>" value="<%= value || '' %>" />
            <% if (error) { %>
                <span class="help-inline text-danger"><%= error.msg %></span>
            <% } %>
        </div>
    </div>
    <% } %>

    <% inputField('First Name', 'firstName', owner.firstName) %>
    <% inputField('Last Name', 'lastName', owner.lastName) %>
    <% inputField('Address', 'address', owner.address) %>
    <% inputField('City', 'city', owner.city) %>
    <% inputField('Telephone', 'telephone', owner.telephone) %>

    <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10">
            <button class="btn btn-primary" type="submit">
                <%= owner.id ? 'Update Owner' : 'Add Owner' %>
            </button>
        </div>
    </div>
</form>
