{
  "name": "petclinic-node",
  "version": "1.0.0",
  "description": "Node.js implementation of Spring PetClinic",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development nodemon server.js",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:reset": "npx sequelize-cli db:migrate:undo:all",
    "seed": "npx sequelize-cli db:seed:all",
    "seed:undo": "npx sequelize-cli db:seed:undo:all",
    "test": "NODE_ENV=test mocha --require ./test/setup.js --recursive --exit"
  },
  "keywords": [],
  "author": "Google Senior Engineer",
  "license": "Apache-2.0",
  "dependencies": {
    "body-parser": "^1.20.2",
    "connect-flash": "^0.1.1",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "express-validator": "^7.1.0",
    "i18n": "^0.15.1",
    "moment": "^2.30.1",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.2",
    "mocha": "^10.x",
    "chai": "^4.x",
    "supertest": "^6.x",
    "ejs-mate": "^4.0.0"
  }
}

