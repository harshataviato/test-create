<h2>Owner</h2>
<form class="form-horizontal" method="post">
  <div class="form-group has-feedback mb-3">
    <label class="col-sm-2 control-label">First Name</label>
    <div class="col-sm-10">
      <input class="form-control {{#if errors.firstName}}is-invalid{{/if}}" name="firstName" value="{{owner.firstName}}" />
      {{#if errors.firstName}}<span class="invalid-feedback">{{errors.firstName.msg}}</span>{{/if}}
    </div>
  </div>
  <div class="form-group has-feedback mb-3">
    <label class="col-sm-2 control-label">Last Name</label>
    <div class="col-sm-10">
      <input class="form-control {{#if errors.lastName}}is-invalid{{/if}}" name="lastName" value="{{owner.lastName}}" />
      {{#if errors.lastName}}<span class="invalid-feedback">{{errors.lastName.msg}}</span>{{/if}}
    </div>
  </div>
  <div class="form-group has-feedback mb-3">
    <label class="col-sm-2 control-label">Address</label>
    <div class="col-sm-10">
      <input class="form-control {{#if errors.address}}is-invalid{{/if}}" name="address" value="{{owner.address}}" />
      {{#if errors.address}}<span class="invalid-feedback">{{errors.address.msg}}</span>{{/if}}
    </div>
  </div>
  <div class="form-group has-feedback mb-3">
    <label class="col-sm-2 control-label">City</label>
    <div class="col-sm-10">
      <input class="form-control {{#if errors.city}}is-invalid{{/if}}" name="city" value="{{owner.city}}" />
      {{#if errors.city}}<span class="invalid-feedback">{{errors.city.msg}}</span>{{/if}}
    </div>
  </div>
  <div class="form-group has-feedback mb-3">
    <label class="col-sm-2 control-label">Telephone</label>
    <div class="col-sm-10">
      <input class="form-control {{#if errors.telephone}}is-invalid{{/if}}" name="telephone" value="{{owner.telephone}}" />
      {{#if errors.telephone}}<span class="invalid-feedback">{{errors.telephone.msg}}</span>{{/if}}
    </div>
  </div>
  <div class="form-group">
    <div class="col-sm-offset-2 col-sm-10">
      <button class="btn btn-primary" type="submit">{{#if owner.id}}Update{{else}}Add{{/if}} Owner</button>
    </div>
  </div>
</form>
