<%- include('../partials/header') %>

<h2>Owner</h2>

<form class="form-horizontal" method="post">
  <!-- Reusable Input Block could be an include, simpler inline here -->
  <% 
    const inputs = [
      { label: 'First Name', name: 'firstName' },
      { label: 'Last Name', name: 'lastName' },
      { label: 'Address', name: 'address' },
      { label: 'City', name: 'city' },
      { label: 'Telephone', name: 'telephone' }
    ];
  %>

  <% inputs.forEach(function(input) { 
     const error = (locals.errors || []).find(e => e.path === input.name);
  %>
    <div class="form-group mb-2 <%= error ? 'has-error' : '' %>">
      <label class="col-sm-2 control-label"><%= input.label %></label>
      <div class="col-sm-10">
        <input class="form-control" type="text" name="<%= input.name %>" value="<%= owner[input.name] || '' %>" />
        <% if (error) { %>
          <span class="help-inline text-danger"><%= error.msg %></span>
        <% } %>
      </div>
    </div>
  <% }); %>

  <div class="form-group mt-3">
    <div class="col-sm-offset-2 col-sm-10">
      <button class="btn btn-primary" type="submit">
        <%= owner.id ? 'Update Owner' : 'Add Owner' %>
      </button>
    </div>
  </div>
</form>

<%- include('../partials/footer') %>
