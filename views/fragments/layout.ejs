<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PetClinic :: a Node.js Port</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/petclinic.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/"><span></span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="main-navbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link <%= menu === 'home' ? 'active' : '' %>" href="/">
                            <i class="fa fa-home"></i> <%= messages.home %>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= menu === 'owners' ? 'active' : '' %>" href="/owners/find">
                            <i class="fa fa-search"></i> <%= messages.findOwners %>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= menu === 'vets' ? 'active' : '' %>" href="/vets.html">
                            <i class="fa fa-th-list"></i> <%= messages.vets %>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/oups">
                            <i class="fa fa-exclamation-triangle"></i> <%= messages.error %>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <%- body %>
        <hr>
        <div class="footer text-center">
            <img src="/images/spring-logo.svg" style="width: 150px" alt="Logo">
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
