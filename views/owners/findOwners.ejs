<h2><%= __('findOwners') %></h2>
<form action="/owners" method="get" class="form-horizontal">
  <div class="form-group">
    <label class="col-sm-2 control-label"><%= __('lastName') %></label>
    <div class="col-sm-10">
      <input class="form-control" name="lastName" value="<%= owner.lastName || '' %>" />
      <% if (locals.error) { %>
        <span class="help-inline text-danger"><%= __('notFound') %></span>
      <% } %>
    </div>
  </div>
  <div class="form-group mt-3">
    <button type="submit" class="btn btn-primary"><%= __('findOwner') %></button>
    <a class="btn btn-secondary mt-2" href="/owners/new"><%= __('addOwner') %></a>
  </div>
</form>
