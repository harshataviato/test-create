<%- include('../layout', { body: `
  <h2><%= pet.id ? 'Pet' : 'New Pet' %></h2>
  
  <form class="form-horizontal" method="post">
    <div class="form-group mb-2">
        <label class="col-sm-2 control-label">Owner</label>
        <div class="col-sm-10">
            <span class="form-control-plaintext"><%= owner.firstName %> <%= owner.lastName %></span>
        </div>
    </div>

    <div class="form-group mb-2">
        <label class="col-sm-2 control-label">Name</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" name="name" value="<%= pet.name || '' %>" />
            <% if (errors && errors.name) { %>
                <span class="help-inline text-danger"><%= errors.name.msg %></span>
            <% } %>
        </div>
    </div>

    <div class="form-group mb-2">
        <label class="col-sm-2 control-label">Birth Date</label>
        <div class="col-sm-10">
            <input type="date" class="form-control" name="birthDate" value="<%= pet.birthDate || '' %>" />
            <% if (errors && errors.birthDate) { %>
                <span class="help-inline text-danger"><%= errors.birthDate.msg %></span>
            <% } %>
        </div>
    </div>

    <div class="form-group mb-2">
        <label class="col-sm-2 control-label">Type</label>
        <div class="col-sm-10">
            <select class="form-control" name="typeId">
                <% types.forEach(function(type) { %>
                    <option value="<%= type.id %>" <%= (pet.typeId == type.id) ? 'selected' : '' %> >
                        <%= type.name %>
                    </option>
                <% }); %>
            </select>
        </div>
    </div>

    <div class="form-group mt-3">
        <div class="col-sm-offset-2 col-sm-10">
            <button class="btn btn-primary" type="submit">
                <%= pet.id ? 'Update Pet' : 'Add Pet' %>
            </button>
        </div>
    </div>
  </form>
` }) %>
