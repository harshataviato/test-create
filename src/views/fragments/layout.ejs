<!DOCTYPE html>
<html lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="shortcut icon" type="image/x-icon" href="/resources/images/favicon.png">
  <title><%= i18n.__('layoutTitle') %></title>
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="/webjars/@fortawesome/fontawesome-free/css/all.min.css">
  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="/webjars/css/bootstrap.min.css">
  <!-- Custom PetClinic CSS -->
  <link rel="stylesheet" href="/resources/css/petclinic.css" />
</head>
<body>

  <nav class="navbar navbar-expand-lg navbar-dark" role="navigation">
    <div class="container-fluid">
      <a class="navbar-brand" href="/"><span></span></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navbar" aria-controls="main-navbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="main-navbar">
        <ul class="navbar-nav me-auto">
          <li class="nav-item">
            <a class="nav-link <%= path === '/' ? 'active' : '' %>" href="/" title="<%= i18n.__('home') %>">
              <span class="fa fa-home"></span>
              <span><%= i18n.__('home') %></span>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= path.startsWith('/owners') ? 'active' : '' %>" href="/owners/find" title="<%= i18n.__('findOwners') %>">
              <span class="fa fa-search"></span>
              <span><%= i18n.__('findOwners') %></span>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= path.startsWith('/vets') ? 'active' : '' %>" href="/vets/vets.html" title="<%= i18n.__('vets') %>">
              <span class="fa fa-th-list"></span>
              <span><%= i18n.__('vets') %></span>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= path.startsWith('/oups') ? 'active' : '' %>" href="/oups" title="<%= i18n.__('error') %>">
              <span class="fa fa-exclamation-triangle"></span>
              <span><%= i18n.__('error') %></span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container-fluid">
    <div class="container xd-container">
      <% if (messages && Object.keys(messages).length > 0) { %>
        <% for (let type in messages) { %>
          <% if (messages[type].length > 0) { %>
            <div class="alert alert-<%= type === 'success' ? 'success' : 'danger' %> alert-dismissible fade show" role="alert">
              <% messages[type].forEach(msg => { %>
                <p><%= msg %></p>
              <% }) %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>
        <% } %>
      <% } %>

      <% if (template) { %>
        <% locals[template]() %>
      <% } %>

      <br />
      <br />
      <div class="container">
        <div class="row">
          <div class="col-12 text-center">
            <img src="/resources/images/spring-logo.svg" alt="VMware Tanzu Logo" class="logo">
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap Bundle with Popper -->
  <script src="/webjars/js/bootstrap.bundle.min.js"></script>
</body>
</html>
