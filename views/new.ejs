<!-- 
  Module: Create Task View
  Description: Form to input data for a new Task.
-->
<%- include('layout', { body: `
    <div class="card p-4">
        <h2 class="mb-4">Create New Task</h2>
        
        <form action="/new" method="POST">
            <div class="mb-3">
                <label for="title" class="form-label fw-bold">Task Title <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="title" name="title" required placeholder="Enter task title">
            </div>
            
            <div class="mb-3">
                <label for="description" class="form-label fw-bold">Description</label>
                <textarea class="form-control" id="description" name="description" rows="4" placeholder="Optional details..."></textarea>
            </div>
            
            <div class="d-flex justify-content-between">
                <a href="/" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-success">Save Task</button>
            </div>
        </form>
    </div>
` }) %>
