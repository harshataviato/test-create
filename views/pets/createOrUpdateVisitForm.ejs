<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../fragments/layout', { template: '', menu: 'owners', noContent: true }) %>
</head>
<body>
  <%- include('../fragments/layout', { template: 'createOrUpdateVisitForm_content', menu: 'owners', noContent: false,
    owner: owner, pet: pet, visit: visit, errors: typeof errors !== 'undefined' ? errors : {}, formatDateToYYYYMMDD: formatDateToYYYYMMDD
  }) %>
</body>
</html>

<% /* This content block is included by the layout fragment */ %>
<% /* filename: views/pets/createOrUpdateVisitForm.ejs (content block) */ %>
<%- defineContent('createOrUpdateVisitForm_content', () => { %>
  <h2>
    <% if (visit.isNew) { %>
      <%= __('new') %>
    <% } %>
    Visit
  </h2>

  <b><%= __('pet') %></b>
  <table class="table table-striped">
    <thead>
      <tr>
        <th><%= __('name') %></th>
        <th><%= __('birthDate') %></th>
        <th><%= __('type') %></th>
        <th><%= __('owner') %></th>
      </tr>
    </thead>
    <tr>
      <td><%= pet.name %></td>
      <td><%= formatDateToYYYYMMDD(pet.birthDate) %></td>
      <td><%= pet.type.name %></td>
      <td><%= owner.firstName %> <%= owner.lastName %></td>
    </tr>
  </table>

  <form action="/owners/<%= owner.id %>/pets/<%= pet.id %>/visits/new" class="form-horizontal" method="post">
    <div class="form-group has-feedback">
      <%- include('../fragments/inputField', { label: __('date'), name: 'date', type: 'date', model: visit, errors: errors, __: __ }) %>
      <%- include('../fragments/inputField', { label: __('description'), name: 'description', type: 'text', model: visit, errors: errors, __: __ }) %>
    </div>

    <div class="form-group">
      <div class="col-sm-offset-2 col-sm-10">
        <input type="hidden" name="petId" value="<%= pet.id %>" />
        <button class="btn btn-primary" type="submit"><%= __('addVisit') %></button>
      </div>
    </div>
  </form>

  <br />
  <b><%= __('previousVisits') %></b>
  <table class="table table-striped">
    <tr>
      <th><%= __('date') %></th>
      <th><%= __('description') %></th>
    </tr>
    <% if (pet.visits && pet.visits.length > 0) { %>
      <% pet.visits.forEach(oldVisit => { %>
        <tr>
          <td><%= formatDateToYYYYMMDD(oldVisit.date) %></td>
          <td><%= oldVisit.description %></td>
        </tr>
      <% }); %>
    <% } %>
  </table>
<% }) %>
