<%- include('../fragments/layout', { body: `
    <h2>Owners</h2>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Address</th>
                <th>City</th>
                <th>Telephone</th>
                <th>Pets</th>
            </tr>
        </thead>
        <tbody>
            ${listOwners.map(owner => `
                <tr>
                    <td><a href="/owners/${owner.id}">${owner.firstName} ${owner.lastName}</a></td>
                    <td>${owner.address}</td>
                    <td>${owner.city}</td>
                    <td>${owner.telephone}</td>
                    <td>${owner.pets ? owner.pets.map(p => p.name).join(', ') : ''}</td>
                </tr>
            `).join('')}
        </tbody>
    </table>
` }) %>
